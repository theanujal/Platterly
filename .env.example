# Copy to .env and fill in real values. Never commit .env itself.

# Postgres connection string. Local dev default (see dev plans/chunk-01 Group 1.1):
# brew install postgresql@16 && brew services start postgresql@16, then create a
# dedicated `platterly_app` role + `platterly_dev` database owned by it.
DATABASE_URL="postgresql://platterly_app:CHANGE_ME@localhost:5432/platterly_dev?schema=public"

# Better Auth — generate a real secret per environment, e.g. `openssl rand -base64 32`.
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://catering.localhost:3000"

# Product subdomains. Dev: catering.localhost:3000 (caterer product) and
# ops.localhost:3000 (Super Admin). Production: https://catering.platterly.in and
# https://ops.platterly.in, with ROOT_DOMAIN="platterly.in".
ROOT_DOMAIN="localhost:3000"
NEXT_PUBLIC_APP_URL="http://catering.localhost:3000"

# Chunk 4 — required only to run e2e/super-admin.spec.ts. Create the account
# via /super sign-up, then flip isSuperAdmin=true for that user directly in
# the DB (Better Auth's signup payload can't set it). Never commit real
# values for these.
SUPER_ADMIN_EMAIL="CHANGE_ME"
SUPER_ADMIN_PASSWORD="CHANGE_ME"

# Chunk 14 — encrypts each kitchen's own Razorpay keys at rest (AES-256-GCM). Any long random string,
# e.g. `openssl rand -base64 32`. In dev it falls back to BETTER_AUTH_SECRET, so nothing is required locally;
# set it in production and never change it afterwards (saved keys could no longer be read).
PAYMENT_SECRETS_KEY=

# Chunk 16 — Zoho ZeptoMail. Leave unset in dev/CI: emails are then log-only (the sign-up code prints in the
# server log). ZEPTOMAIL_TOKEN is the "Send Mail token"; ZEPTOMAIL_FROM must be a verified sender address.
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email

# Chunk 16 — secret for the scheduled job at /api/cron/daily (reminders, payment notices, repeating expenses).
# Any long random string (`openssl rand -base64 32`). Unset = the endpoint answers 404. Call it every ~10 minutes:
#   curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://catering.platterly.in/api/cron/daily
CRON_SECRET=

# Chunk 16.3 — Web Push (VAPID keys). Generate once with:
#   node -e 'const k=require("web-push").generateVAPIDKeys();console.log(k)'
# Never change them after launch, or every enabled device stops receiving push.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@platterly.in"
