# /srv/platterly/env/platform.env (chmod 600, owner platterly). Both slots read the same file. One app serves auth., account. and store.platterly.in.
# Two databases: the Platform's own, and the identity one (people, passwords, sessions). Create both, with their own role, before the first deploy.
DATABASE_URL="postgresql://platterly_platform_app:CHANGE_ME@localhost:5432/platterly_platform?schema=public"
IDENTITY_DATABASE_URL="postgresql://platterly_platform_app:CHANGE_ME@localhost:5432/platterly_identity"
# Signs sign-in links and keys saved secrets. Generate once (openssl rand -base64 48), keep in the password manager, never change.
AUTH_SECRET=
# Optional dedicated key for secrets stored by the Platform; falls back to AUTH_SECRET when empty. Never change once data exists.
PLATFORM_SECRETS_KEY=
# The bare domain; the hosts are auth., account. and store. in front of it.
ROOT_DOMAIN="platterly.in"
CRON_SECRET=
# The link to Platterly Ops. Same values as Ops's PLATFORM_BILLING_SECRETS / platform-reader secret (docs/platform-reader-secret.md).
OPS_BASE_URL="https://ops.platterly.in"
OPS_PLATFORM_BILLING_SECRET=
OPS_PLATFORM_READER_SECRET=
# Mail (sign-in codes, reset codes, notices). Same ZeptoMail account and sender as live Caterly.
# Required here: unlike Ops and catering, the Platform mailer has no default address. Without it every sign-in code, verification code and password reset
# fails silently (the person sees the normal screen; the error is only logged).
ZEPTOMAIL_API_URL="https://api.zeptomail.in/v1.1/email"
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# Real email. The mail guard (packages/contract/src/mail-guard.ts) is ON unless this says off: real mail goes ONLY to the allowed address (npjalota@gmail.com, or
# MAIL_GUARD_ALLOW). That is right until go-live and wrong after it: with the guard on, sign-in codes, password resets and customer email are silently skipped.
# Go-live step 6b sets it to off in catering.env, ops.env and platform.env; deploy.sh warns in its log while it is on.
MAIL_GUARD=on
EMAIL_LOGO_URL="https://platterly.in/platterly-logo.png"
# Saved profile photos and business logos stay on this server, outside the releases, shared by blue and green. In the nightly backup (account-files).
ACCOUNT_PHOTO_DIR=/srv/platterly/account/photos
ACCOUNT_LOGO_DIR=/srv/platterly/account/logos
# Same value in every slot, generated once (openssl rand -base64 32), so a page opened on blue still works after a switch to green.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# NEVER set in production: AUTH_RATE_LIMIT_OFF, PLATFORM_TEST_CREDENTIALS_DIR, MAIL_SINK_DIR. Never point ZEPTOMAIL_API_URL at the local mail sink (localhost:3600).
