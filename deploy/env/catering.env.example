# /srv/platterly/env/catering.env (chmod 600, owner platterly). Both slots read the same file.
DATABASE_URL="postgresql://platterly_app:CHANGE_ME@localhost:5432/platterly_catering?schema=public"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="https://catering.platterly.in"
NEXT_PUBLIC_APP_URL="https://catering.platterly.in"
ROOT_DOMAIN="platterly.in"
PAYMENT_SECRETS_KEY=
CRON_SECRET=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
EMAIL_LOGO_URL="https://catering.platterly.in/platterly-logo.png"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@platterly.in"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
OPS_BASE_URL="https://ops.platterly.in"
OPS_PRODUCT_KEY=catering
OPS_EVENT_SECRET=
OPS_COMMAND_SECRETS=
OPS_BILLING=
# Files stay on this server, outside the releases, shared by blue and green; Nginx serves /uploads/ from here.
UPLOAD_ROOT=/srv/platterly/uploads
# Same value in every slot, generated once (openssl rand -base64 32), so a page opened on blue still works after a switch to green.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Error monitoring (Sentry). Leave empty to switch it off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
