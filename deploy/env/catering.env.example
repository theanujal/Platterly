# /srv/platterly/env/catering.env (chmod 600, owner platterly). Both slots read the same file.
DATABASE_URL="postgresql://platterly_app:CHANGE_ME@localhost:5432/platterly_catering?schema=public"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="https://catering.platterly.in"
NEXT_PUBLIC_APP_URL="https://catering.platterly.in"
ROOT_DOMAIN="platterly.in"
PAYMENT_SECRETS_KEY=
CRON_SECRET=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# Real email. The mail guard (packages/contract/src/mail-guard.ts) is ON unless this says off: real mail goes ONLY to the allowed address (npjalota@gmail.com, or
# MAIL_GUARD_ALLOW). That is right until go-live and wrong after it: with the guard on, sign-in codes, password resets and customer email are silently skipped.
# Go-live step 6b sets it to off in catering.env, ops.env and platform.env; deploy.sh warns in its log while it is on.
MAIL_GUARD=on
EMAIL_LOGO_URL="https://catering.platterly.in/platterly-logo.png"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT="mailto:noreply@platterly.in"
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# Catering has no login of its own: people sign in at the Platform. REQUIRED. deploy.sh refuses to release catering unless this answers.
PLATFORM_AUTH_ORIGIN="https://auth.platterly.in"
PLATFORM_ACCOUNT_ORIGIN="https://account.platterly.in"
PLATFORM_STORE_ORIGIN="https://store.platterly.in"
# The business link with the Platform (membership and business events): the two secrets from go-live step 3c (the register-product runner prints them once).
# REQUIRED: without both, catering answers 404 to the Platform and the membership event that adopts a business never arrives. deploy.sh refuses to release
# catering unless both are set.
PLATFORM_COMMAND_SECRETS=
PLATFORM_ANSWER_SECRET=
OPS_BASE_URL="https://ops.platterly.in"
OPS_PRODUCT_KEY=catering
OPS_EVENT_SECRET=
OPS_COMMAND_SECRETS=
OPS_BILLING=
# WhatsApp through Wacrm (the kitchen's own team messages). Empty = off. WACRM_TEST_TO sends everything to one number while testing.
WACRM_BASE_URL=
WACRM_API_KEY=
WACRM_TEST_TO=
WACRM_TEMPLATES_APPROVED=
# Files stay on this server, outside the releases, shared by blue and green; Nginx serves /uploads/ from here.
UPLOAD_ROOT=/srv/platterly/uploads
# Same value in every slot, generated once (openssl rand -base64 32), so a page opened on blue still works after a switch to green.
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
# Error monitoring (Sentry). Leave empty to switch it off.
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
