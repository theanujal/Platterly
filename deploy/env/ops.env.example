# /srv/platterly/env/ops.env (chmod 600, owner platterly). Both slots read the same file.
DATABASE_URL="postgresql://platterly_ops:CHANGE_ME@localhost:5432/platterly_ops?schema=public"
BETTER_AUTH_SECRET=
BETTER_AUTH_URL="https://ops.platterly.in"
OPS_TRUSTED_ORIGINS="https://ops.platterly.in"
OPS_SECRETS_KEY=
CRON_SECRET=
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# Real email. The mail guard (packages/contract/src/mail-guard.ts) is ON unless this says off: real mail goes ONLY to the allowed address (npjalota@gmail.com, or
# MAIL_GUARD_ALLOW). That is right until go-live and wrong after it: with the guard on, sign-in codes, password resets and customer email are silently skipped.
# Go-live step 6b sets it to off in catering.env, ops.env and platform.env; deploy.sh warns in its log while it is on.
MAIL_GUARD=on
# Billing WhatsApps to the business's number (docs/ops-contract.md 9). Empty = off. WACRM_TEST_TO sends everything to one number while testing.
WACRM_BASE_URL=
WACRM_API_KEY=
WACRM_TEST_TO=
WACRM_TEMPLATES_APPROVED=
SITE_SECRET=
SITE_DEPLOY_HOOK_URL=
STAFF_NOTIFY_EMAILS=
SITE_MEDIA_DIR=/srv/platterly/site-media
# Which sites may post the "Book a demo" form to /api/public/enquiries.
SITE_ORIGINS="https://platterly.in,https://www.platterly.in"
NEXT_SERVER_ACTIONS_ENCRYPTION_KEY=
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
