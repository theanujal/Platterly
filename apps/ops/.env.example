# Ops has its own database, separate from every product. Local dev: create `platterly_ops` owned by `platterly_app`.
DATABASE_URL="postgresql://platterly_app:CHANGE_ME@localhost:5432/platterly_ops?schema=public"

# Better Auth for ops staff only. Generate a real secret per environment: `openssl rand -base64 32`.
BETTER_AUTH_SECRET="CHANGE_ME"
BETTER_AUTH_URL="http://ops.localhost:3200"
# Extra origins allowed to sign in (comma separated). Dev default is BETTER_AUTH_URL only.
OPS_TRUSTED_ORIGINS=

# Encrypts the per-product signing secrets stored in the registry (AES-256-GCM). Any long random string.
# Set it in production and never change it afterwards (saved secrets could no longer be read).
OPS_SECRETS_KEY=

# Secret for the scheduled job at /api/cron (sends and retries commands to products). Any long random string.
# Call it every minute or two: curl -fsS -H "Authorization: Bearer $CRON_SECRET" https://ops.platterly.in/api/cron
# Unset = the endpoint answers 404.
CRON_SECRET=

# Platterly's own Razorpay account (what businesses pay Platterly for a plan). Leave unset to keep online payment off:
# checkout then answers "not switched on yet". Webhook URL: https://ops.platterly.in/api/webhooks/razorpay with the events
# payment.captured and payment.failed. A kitchen's own Razorpay (its customers paying it) stays in the product.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Owner emails (receipts, trial notices, welcome). Same ZeptoMail account as catering; with no token set nothing is sent and
# each message is kept in the log as "skipped". EMAIL_LOGO_URL is the public address of the logo (otherwise it travels inside
# the email).
ZEPTOMAIL_TOKEN=
ZEPTOMAIL_FROM=
# ZEPTOMAIL_API_URL=https://api.zeptomail.in/v1.1/email
# EMAIL_LOGO_URL=

