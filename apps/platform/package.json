{
  "name": "platterly-platform",
  "version": "0.1.0",
  "private": true,
  "description": "Platterly Platform: one sign-in, the Account and the Store for every product. One app serving the auth, account and store hosts; its own database; products talk to it only through packages/platform-contract. Plan: docs/platform-foundation-plan.md.",
  "scripts": {
    "dev": "next dev -p 3300",
    "build": "next build",
    "start": "next start -p 3300",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "postinstall": "prisma generate",
    "identity:migrate": "node scripts/identity-migrate.mjs"
  },
  "dependencies": {
    "@better-auth/core": "1.7.15",
    "@better-auth/oauth-provider": "1.7.15",
    "@prisma/adapter-pg": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "better-auth": "1.7.15",
    "better-call": "1.4.4",
    "dotenv": "^17.4.2",
    "jose": "6.2.3",
    "next": "16.4.3",
    "pg": "^8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "server-only": "^0.0.1"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "@types/pg": "^8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "prisma": "^7.10.1",
    "typescript": "^5",
    "vitest": "^5.0.0"
  },
  "allowScripts": {
    "prisma@7.10.1": true,
    "@prisma/engines@7.10.1": true
  }
}
