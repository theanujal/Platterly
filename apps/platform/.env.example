# Platform is one app serving three hosts: auth.<root>, account.<root> and store.<root>.
# Local dev: *.localhost resolves to this machine, so http://auth.localhost:3300 works without any setup.
ROOT_DOMAIN="localhost:3300"

# Platform has its own database (platterly_platform) and its own role, separate from catering and Ops.
# Local dev: create role platterly_platform_app (LOGIN CREATEDB) and database platterly_platform owned by it.
DATABASE_URL="postgresql://platterly_platform_app:CHANGE_ME@localhost:5432/platterly_platform?schema=public"

# Isolated test database for the migration round trip (F3.1.1). Leave empty. When set it must be the protected folder ~/.platterly/stage2
# (mode 700); the passwords and the sentinel token stay in files in there and are never written here.
PLATFORM_TEST_CREDENTIALS_DIR=

# F4 sign-in (Better Auth, decision D1). The identity database is SEPARATE from the Platform database; there is no fallback between them.
# Create it like the Platform database, then: npm run identity:migrate
IDENTITY_DATABASE_URL="postgresql://platterly_platform_app:CHANGE_ME@localhost:5432/platterly_identity"
# At least 32 characters; signs the Account's cookies and the provider's own. Generate: openssl rand -hex 32
AUTH_SECRET=
# Auth email goes through the ZeptoMail REST shape. D5 (sender and templates) is open: locally point it at the mail sink (npm run mail-sink).
# ZEPTOMAIL_API_URL="http://localhost:3600/v1.1/email"
# ZEPTOMAIL_TOKEN="local-sink"
# ZEPTOMAIL_FROM="no-reply@auth.localhost"
# Local end-to-end runs only (many sign-ups from one IP). Ignored when NODE_ENV=production. Never set this anywhere else.
# AUTH_RATE_LIMIT_OFF=1
# Test databases for the F4 integration tests; the tests skip without them and the identity one is rebuilt on every run (its name must contain "test").
# IDENTITY_TEST_DATABASE_URL=
# PLATFORM_F4_TEST_DATABASE_URL=

# Store checkout: the same value as PLATFORM_BILLING_SECRETS in Ops. Never the platform-reader secret.
# OPS_PLATFORM_BILLING_SECRET=""
