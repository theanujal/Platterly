// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  isSuperAdmin Boolean @default(false)

  // First/Last name are the real source of truth for a person's name
  // throughout the app; `name` stays required (Better Auth's own core
  // field) and is composed as `${firstName} ${lastName}`.trim() at every
  // write site — see src/lib/auth/auth.ts's `additionalFields`.
  firstName String?
  lastName  String?

  // Collected at signup via the shared `PhoneInput` (AJ, 2026-09-19) — see
  // `additionalFields.phone` in src/lib/auth/auth.ts.
  phone String?

  // --- Chunk 16.3: Web Push, per person ---
  // `pushEnabled` is the person's one master switch; devices live in PushSubscription. The prompt fields drive
  // the "Stay updated" popup: asked at sign-up, then again every 3 days after "Maybe Later" (up to 5 times).
  pushEnabled       Boolean            @default(true)
  pushPromptState   PushPromptState    @default(PENDING)
  pushPromptCount   Int                @default(0)
  pushPromptNextAt  DateTime?
  pushSubscriptions PushSubscription[]

  notificationsReceived        Notification[]
  auditLogsActedOn             AuditLog[]
  inventoryTransactionsActedOn InventoryTransaction[]

  @@unique([email])
  @@map("user")
}

enum PushPromptState {
  PENDING
  LATER
  ENABLED
  NEVER
  EXHAUSTED
}

// One row per browser/device a person enabled push on. `endpoint` is the browser's private address for it.
model PushSubscription {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint   String    @unique
  p256dh     String
  auth       String
  userAgent  String?
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?

  @@index([userId])
  @@map("push_subscription")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  branches    Branch[]
  kitchens    Kitchen[]
  stores      Store[]

  notifications      Notification[]
  whatsAppMessages   WhatsAppMessage[]
  auditLogs          AuditLog[]
  secureAccessTokens SecureAccessToken[]
  settings           TenantSetting[]

  // --- Chunk 3 Group 3.2: Super Admin tenant management (PRD §8) ---
  status          TenantStatus @default(ACTIVE)
  ownerFirstName  String?
  ownerLastName   String?
  contactPhone    String?
  contactEmail    String?
  gstNumber       String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  // Chunk 8's self-service limit is 2 free changes to `slug`; a Super Admin
  // can force further changes once this is exhausted (Group 3.2). The slug
  // column doubles as both the Better-Auth org slug and the public
  // storefront slug — there is only one.
  slugChangeCount Int          @default(0)

  // --- Chunk 4 Group 4.2: Self-serve onboarding business profile ---
  // Extends the same Organization row Chunk 3 already put address/GST/
  // contact fields on, rather than a separate BusinessProfile table —
  // avoids two places storing overlapping tenant profile data.
  businessDescription String?
  websiteUrl          String?
  instagramUrl        String?
  facebookUrl         String?
  gstShowOnInvoices   Boolean? @default(false)

  // Set only when the onboarding wizard's final "Complete Setup" step
  // succeeds — never by Skip, and never by a later Settings save. Drives
  // the Dashboard's "finish your profile" nudge banner.
  onboardingCompletedAt DateTime?

  // --- Order Numbering — Kitchen Admin-configurable prefix/counter for
  // human-readable Order Numbers (e.g. "AJ-0001"). Assigned once per Order
  // at creation (src/modules/orders/order.ts's nextOrderNumber), never
  // recalculated later — orderNumberNextValue is the atomic counter.
  orderNumberPrefix    String @default("ORD")
  orderNumberNextValue Int    @default(1)
  orderNumberPadding   Int    @default(4)

  // Chunk 14 — atomic counters for INV-0001 / RCT-0001 (src/modules/invoices/invoice.ts).
  invoiceNextValue Int @default(1)
  receiptNextValue Int @default(1)

  invoices           Invoice[]
  payments           Payment[]
  expenses           Expense[]
  expenseAttachments ExpenseAttachment[]
  recurringExpenses  RecurringExpense[]
  paymentLinks       PaymentLink[]
  customerNotes      CustomerNote[]

  subscriptions Subscription[]

  menuCategories   MenuCategory[]
  menuItems        MenuItem[]
  menus            Menu[]
  eventTypes       EventType[]
  addOns           AddOn[]
  inventoryItems   Inventory[]
  recipes          Recipe[]
  purchaseOrders   PurchaseOrder[]
  supplierPayments SupplierPayment[]
  staffMembers     StaffMember[]
  staffAssignments StaffAssignment[]
  suppliers        Supplier[]
  customers        Customer[]
  events           Event[]
  orders           Order[]
  quotations       Quotation[]
  menuSelections   MenuSelection[]
  storefrontDrafts StorefrontDraft[]

  @@unique([slug])
  @@map("organization")
}

// Chunk 3 Group 3.2 — Suspend/Activate/Deactivate are three distinct admin
// actions (PRD §8.2), not two independent booleans. No hard-delete path: an
// Organization's FKs cascade into its own AuditLog, so a literal delete
// would destroy the record of the very action deleting it.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // Chunk 5 Group 5.2 — reversible "disable a teammate" state. Better Auth's
  // own API only offers a hard-delete `removeMember`; this is the softer
  // state that requireActiveOrganization()/requireOrg() enforce, locking a
  // disabled member out of every caterer-facing route without removing them.
  disabledAt DateTime?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- App-level models (not owned by Better Auth) ---
// Branch/Kitchen/Store hierarchy, PRD §47: Tenant(Organization) -> Branch ->
// Kitchen/Store -> Users/Inventory/Events. Schema now, multi-location UI
// later (Chunk 23) — every table below still carries `organizationId`
// directly (not just via Branch) so tenant-isolation queries never need a
// join to be enforced (PRD §54-55).

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  kitchens Kitchen[]
  stores   Store[]

  @@index([organizationId])
  @@map("branch")
}

model Kitchen {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events Event[]

  @@index([organizationId])
  @@index([branchId])
  @@map("kitchen")
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("store")
}

// --- Chunk 2: Cross-Cutting Platform Service Interfaces ---
// Interfaces many later, unrelated chunks call — "interface now, integration
// later" (same pattern as auth's pluggable strategy from Chunk 1). Real
// WhatsApp/ZeptoMail/Push providers land in Chunk 16; these models exist
// so every module from Chunk 9 onward has something to call today.

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
  PUSH
}

model Notification {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  event           String
  // Recipients are frequently customers (no `User` row exists for them until
  // Chunk 9's Customer model, and even then Customer isn't a User) — kept as
  // plain fields rather than a hard FK so this interface doesn't have to
  // change shape once Customer exists.
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  payload         Json
  createdAt       DateTime            @default(now())
  // In-app alerts only: when the person opened or cleared it (the bell's unread count).
  readAt          DateTime?

  logs             NotificationLog[]
  whatsAppMessages WhatsAppMessage[]

  @@index([organizationId])
  @@index([recipientUserId, channel, readAt])
  @@map("notification")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@map("notification_log")
}

model WhatsAppMessage {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId    String?
  notification      Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  toPhone           String
  body              String
  providerMessageId String?
  status            String        @default("queued")
  createdAt         DateTime      @default(now())

  @@index([organizationId])
  @@map("whatsapp_message")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Audit trail must survive the actor being removed later — SetNull, not
  // Cascade, and the field stays optional.
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  recordType     String
  recordId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([organizationId, createdAt])
  @@index([recordType, recordId])
  @@map("audit_log")
}

// MENU_SELECTION removed 2026-09-17 — Chunk 11 doesn't use this token
// service (see src/lib/secure-access/token.ts's header comment).
enum SecureAccessResourceType {
  QUOTATION
  INVOICE
  PAYMENT_LINK
  // resourceId = a MenuVersion id, so a link is tied to one specific version.
  MENU_APPROVAL
}

model SecureAccessToken {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   SecureAccessResourceType
  resourceId     String
  token          String                   @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("secure_access_token")
}

model TenantSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("tenant_setting")
}

// --- Chunk 3 Group 3.3: Subscription Plans (PRD §9, §58) ---
// Definitions only — no live Razorpay billing yet (Chunk 20 reuses Chunk
// 14's integration). `SubscriptionPlan` is a platform-wide catalog (like
// `User`), not tenant-owned data, so it's deliberately exempt from the
// "every app-level model carries organizationId" convention used elsewhere.

model SubscriptionPlan {
  id                String   @id @default(cuid())
  // Stable machine key (e.g. "trial") that Chunk 4's onboarding wizard looks
  // up directly, independent of the human-editable `name`.
  code              String   @unique
  name              String
  description       String?
  isTrial           Boolean  @default(false)
  // Only meaningful when isTrial — the seeded Trial plan uses 7.
  trialDurationDays Int?
  priceMonthly      Decimal? @db.Decimal(10, 2)
  priceAnnual       Decimal? @db.Decimal(10, 2)
  currency          String   @default("INR")

  // PRD §9 limits list. Null means unlimited.
  maxUsers            Int?
  maxEvents           Int?
  maxOrders           Int?
  maxKitchens         Int?
  maxStores           Int?
  maxCustomers        Int?
  maxMenuLinks        Int?
  maxStorageMb        Int?
  maxReports          Int?
  maxWhatsappMessages Int?

  // Retire a plan without breaking Subscription history's FK — never
  // hard-delete (Restrict below would block it anyway once assigned).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  startDate          DateTime           @default(now())
  trialEndsAt        DateTime?
  // Set when superseded/cancelled; null while this is the tenant's current
  // subscription. History is kept, never deleted (immutable per the updated
  // product doc's accounting/audit note, §19).
  endDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("subscription")
}

// --- Chunk 6: Menu & Product Catalog (PRD §22-24, Updated doc §12) ---
// Reworked 2026-09-14 per AJ's explicit field-level spec, replacing the
// original MenuPackage-based model entirely (no production tenant data
// existed, so this is a clean schema swap, not a migration). Menu is now
// the top-level, priced, sellable object; MenuCategory is a reusable entity
// assigned to Menu(s) via MenuCategoryAssignment, which carries a
// per-(category,menu) max-selection and display order — the same category
// (e.g. "Starters") can allow choosing 2 items on one menu and 3 on
// another, since those are different Menu rows. MenuItem's category tags
// (MenuItemCategory) and its menu assignments (MenuMenuItem) are
// deliberately independent of each other (AJ confirmed), not derived.

model MenuCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  itemAssignments MenuItemCategory[]
  menuAssignments MenuCategoryAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_category")
}

// Reused for both Menu.menuType and MenuItem.foodType — AJ's "Menu Type,
// for ex-veg" field on each.
enum FoodType {
  VEGETARIAN
  NON_VEGETARIAN
}

// Food Item Additional Details (2026-09-17, AJ) — curated single-select
// vocabularies for the Indian-catering domain, each with an OTHER escape
// hatch where the value space is genuinely open-ended. All optional on
// MenuItem; nothing here is required or defaulted.
enum MenuItemOrigin {
  NORTH_INDIAN
  SOUTH_INDIAN
  PUNJABI
  GUJARATI
  BENGALI
  MUGHLAI
  CHINESE
  CONTINENTAL
  ITALIAN
  MEXICAN
  THAI
  SOUTH_EAST_ASIAN
  FUSION
  OTHER
}

enum MenuItemBaseType {
  GRAVY_BASED
  DRY
  CREAM_BASED
  TOMATO_BASED
  COCONUT_BASED
  YOGURT_BASED
  CLEAR
  OTHER
}

enum MenuItemPreparationMethod {
  GRILLED
  ROASTED
  DEEP_FRIED
  SHALLOW_FRIED
  STEAMED
  SAUTEED
  BAKED
  BOILED
  TANDOOR
  RAW
  SLOW_COOKED
  OTHER
}

enum MenuItemSpiceLevel {
  NONE
  MILD
  MEDIUM
  SPICY
  EXTRA_SPICY
}

// Jain-friendly indicator — a common Indian-catering requirement.
enum MenuItemOnionGarlic {
  WITH_ONION_GARLIC
  WITHOUT_ONION_GARLIC
}

enum MenuItemTexture {
  CRISPY
  SOFT
  CREAMY
  CRUNCHY
  SMOOTH
  CHEWY
  JUICY
  FLAKY
  OTHER
}

enum MenuItemTasteProfile {
  SWEET
  SOUR
  SPICY
  TANGY
  SAVORY
  BITTER
  UMAMI
  MILD
}

model MenuItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  foodType       FoodType
  price          Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)

  // Highlight tags (AJ, 2026-10-03): plain checkboxes on the Food Item form, shown as badges on the item card, the
  // list and the customer's dish rows.
  isPopular      Boolean @default(false)
  isChefsSpecial Boolean @default(false)
  isLiveCounter  Boolean @default(false)

  // Additional Details (2026-09-17, AJ) — all optional, edited from the
  // same Food Item form as Basic Information, dynamically consumed by the
  // (not-yet-built) customer-facing menu: a field left unset here simply
  // doesn't render there, no placeholder/default text. `vegFriendly`/
  // `nonVegFriendly` are deliberately independent nullable booleans, not a
  // single enum — distinct from the existing strict `foodType` above,
  // this instead flags whether the dish can additionally suit a veg or
  // non-veg guest (e.g. a base gravy offered either way), so both, one, or
  // neither can be set without forcing a single classification.
  origin            MenuItemOrigin?
  baseType          MenuItemBaseType?
  preparationMethod MenuItemPreparationMethod?
  spiceLevel        MenuItemSpiceLevel?
  onionGarlic       MenuItemOnionGarlic?
  vegFriendly       Boolean?
  nonVegFriendly    Boolean?
  texture           MenuItemTexture?
  tasteProfile      MenuItemTasteProfile?
  // Free text — ingredient names have no fixed vocabulary, unlike the
  // curated fields above. Comma-separated, parsed at the form boundary.
  keyIngredients    String?

  // Chunk 18.1 — optional recipe (ingredient list) for this dish.
  recipe Recipe?

  categories         MenuItemCategory[]
  menus              MenuMenuItem[]
  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  menuSelectionItems MenuSelectionItem[]
  menuVersionItems   MenuVersionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu_item")
}

// MenuItem <-> MenuCategory tagging (many-to-many) — independent of which
// Menus the item is assigned to below; a caterer sets both separately.
model MenuItemCategory {
  id         String       @id @default(cuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([menuItemId, categoryId])
  @@index([menuItemId])
  @@index([categoryId])
  @@map("menu_item_category")
}

model Menu {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  menuType       FoodType
  pricePerPlate  Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)
  // Display order on the public storefront and in Menu Types (AJ, 2026-10-01): the owner or a manager shuffles it
  // with the move up / down buttons, the same convention as EventType.sortOrder.
  sortOrder      Int          @default(0)

  // Children Guests & Pricing — under-5 is complimentary unless explicitly
  // opted into being charged; 5-10 always prices, either as a percentage of
  // this Menu's own pricePerPlate or a flat per-plate amount (chosen via
  // child5To10PricingType), same reused-field-with-a-type-toggle shape as
  // AddOn.priceType/price.
  childUnder5Chargeable Boolean          @default(false)
  childUnder5Price      Decimal?         @db.Decimal(10, 2)
  child5To10PricingType ChildPricingType @default(FIXED)
  child5To10PriceValue  Decimal?         @db.Decimal(10, 2)

  items                    MenuMenuItem[]
  categoryAssignments      MenuCategoryAssignment[]
  eventTypes               EventTypeMenu[]
  orderItems               OrderItem[]
  quotationItems           QuotationItem[]
  mealPlanEntries          MealPlanEntry[]
  quotationMealPlanEntries QuotationMealPlanEntry[]
  childPricingOrders       Order[]
  childPricingQuotations   Quotation[]
  menuSelectionItems       MenuSelectionItem[]
  chosenInSelections       MenuSelection[]          @relation("MenuSelectionChosenMenu")
  menuVersionItems         MenuVersionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu")
}

// Menu <-> MenuItem membership (many-to-many, direct — independent of
// category assignment, per AJ's "Assign to Menus" field on MenuItem).
// sortOrder controls display order within that Menu.
model MenuMenuItem {
  id         String   @id @default(cuid())
  menuId     String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([menuId, menuItemId])
  @@index([menuId])
  @@index([menuItemId])
  @@map("menu_menu_item")
}

// MenuCategory <-> Menu assignment — the same category can be linked to
// multiple menus with a different maxSelection/sortOrder on each (AJ's
// example: "Starters" allows choosing 2 items on a Veg menu, 3 on a
// Non-Veg menu — two different Menu rows, two different assignment rows).
// maxSelection null = unlimited.
model MenuCategoryAssignment {
  id           String       @id @default(cuid())
  menuId       String
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  maxSelection Int?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@unique([menuId, categoryId])
  @@index([menuId])
  @@index([categoryId])
  @@map("menu_category_assignment")
}

// --- Event Types (pulled forward from dev plans/chunk-09-crm-core.md §9.1,
// scoped down to just what AJ asked for here) ---
// A caterer's catalog of the *types* of events they cater (e.g. "Wedding
// Event"), each offering a set of eligible Menus. Deliberately named
// EventType, not Event, even though every user-facing string says "Event"
// — chunk-09-crm-core.md §9.4 reserves the bare name `Event` for a much
// bigger future transactional model (Customer, dates, kitchen, inventory);
// reusing that name now would force a rename migration later. isActive
// wasn't in AJ's field list but is added for consistency with every other
// catalog entity's soft-delete convention here.
model EventType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  minGuests      Int?
  isActive       Boolean      @default(true)
  // Chunk 9 Group 9.1 — a curated icon-name key (see
  // src/lib/event-type-icons.ts), not a free-form upload; Updated doc §7's
  // "Icon"/"Sort order" fields, added on top of the Chunk 6-era scoped-down
  // build. "Default menu/package/pricing rules" (also named in §7) stays
  // deliberately unbuilt — nothing downstream consumes it yet (Quotation/
  // Order is Chunk 10); documented as a deferral, not a silent omission.
  icon           String?
  sortOrder      Int          @default(0)

  menus      EventTypeMenu[]
  events     Event[]
  orders     Order[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("event_type")
}

model EventTypeMenu {
  id          String    @id @default(cuid())
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  menuId      String
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([eventTypeId, menuId])
  @@index([eventTypeId])
  @@index([menuId])
  @@map("event_type_menu")
}

// Add-ons Management (2026-09-14, AJ's own field-level spec): Live Counters
// and Special Add-ons in one shared catalog, distinguished by `type`.
// Deliberately standalone — not assigned to Menus or EventTypes — AJ:
// "these will be Standalone and will be showcased after menu selections,"
// which describes a future order-flow behavior (Chunk 10/11), not anything
// built here. isActive wasn't in AJ's field list but is added for
// consistency with every other catalog entity's soft-delete convention.
enum AddOnType {
  LIVE_COUNTER
  SPECIAL_ADD_ON
}

enum AddOnPriceType {
  PER_PLATE
  FIXED
}

enum ChildPricingType {
  PERCENTAGE
  FIXED
}

model AddOn {
  id                String         @id @default(cuid())
  organizationId    String
  organization      Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  image             String?
  type              AddOnType
  priceType         AddOnPriceType
  price             Decimal        @db.Decimal(10, 2)
  // Part of the package: the customer can still pick it, but it adds nothing to the bill (resolveCatalogItem prices it at 0).
  includedInPackage Boolean        @default(false)
  isActive          Boolean        @default(true)

  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  menuSelectionItems MenuSelectionItem[]
  menuVersionItems   MenuVersionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("add_on")
}

// Chunk 7 (Inventory, Basic) — PRD §35 (subset), Updated doc §13's exact Add
// Inventory Item field list. Simple text-field supplier contact directly on
// the item (no `Ingredient`/full `Supplier` entity/FK yet — that's Chunk 18,
// see the chunk file's note); `storageLocation` stays a plain text field,
// not a `Store` FK, matching Updated doc §13 exactly (multi-location Store
// assignment is Chunk 23 UI on the schema Chunk 1 already stubbed).
enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model Inventory {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  category          String
  description       String?
  image             String?
  unit              String
  // Current on-hand balance — the source of truth for "what do we have",
  // kept in sync with each InventoryTransaction inside one DB transaction
  // (src/modules/inventory/inventory.ts's `recordStockTransaction`) rather
  // than recomputed by summing the ledger on every read.
  stockCount        Decimal      @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal?     @db.Decimal(12, 2)
  costPerUnit       Decimal?     @db.Decimal(10, 2)
  storageLocation   String?
  supplierId        String?
  supplier          Supplier?    @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  expiryDate        DateTime?

  transactions       InventoryTransaction[]
  requiredByEvents   EventRequiredInventory[]
  recipeIngredients  RecipeIngredient[]
  purchaseOrderItems PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("inventory")
}

// Chunk 18.2 — Supplier. Inventory items, expenses and (18.3) purchase orders point at it. SetNull on every
// referrer so deleting a kitchen never hits an ordering hazard; `deleteSupplier` refuses while anything uses it.
model Supplier {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  contactPerson  String?
  phone          String?
  email          String?
  address        String?
  gstin          String?
  notes          String?
  isActive       Boolean      @default(true)

  inventoryItems    Inventory[]
  expenses          Expense[]
  recurringExpenses RecurringExpense[]
  purchaseOrders    PurchaseOrder[]
  payments          SupplierPayment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, name])
  @@map("supplier")
}

// Chunk 19.2 — Staff scheduling (AJ, 2026-10-04). The kitchen team fills it in by hand; nothing is predicted from the
// guest count. A StaffMember is a person with no Platterly login (floor staff); people with a login are Members and
// can be assigned too. An assignment points at exactly one of the two (also enforced by a CHECK in the migration).
enum StaffDuty {
  EVENT_MANAGER
  KITCHEN
  SERVING
  DELIVERY
  SETUP
  STORE
}

model StaffMember {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String?
  // The duty they are usually given; each assignment can still use another.
  defaultDuty    StaffDuty    @default(SERVING)
  notes          String?
  isActive       Boolean      @default(true)

  assignments StaffAssignment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("staff_member")
}

model StaffAssignment {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  eventId         String
  event           Event        @relation(fields: [eventId], references: [id], onDelete: Cascade)
  staffMemberId   String?
  staffMember     StaffMember? @relation(fields: [staffMemberId], references: [id], onDelete: Cascade)
  // Better Auth Member.id (a team member with a login). Plain id: Member is owned by the auth library.
  memberId        String?
  duty            StaffDuty
  notes           String?
  createdByUserId String?

  createdAt DateTime @default(now())

  @@unique([eventId, staffMemberId])
  @@unique([eventId, memberId])
  @@index([organizationId])
  @@index([eventId])
  @@map("staff_assignment")
}

// Chunk 18.3 — Purchasing. DRAFT is the purchase request; ORDERED is sent to the supplier; receiving writes real
// STOCK_IN ledger rows. Restrict to the supplier and inventory so a used record cannot vanish; the purge list and
// the e2e cleanup remove purchase orders first.
enum PurchaseOrderStatus {
  DRAFT
  ORDERED
  PARTIALLY_RECEIVED
  RECEIVED
  CANCELLED
}

model PurchaseOrder {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  number          String
  supplierId      String
  supplier        Supplier            @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  status          PurchaseOrderStatus @default(DRAFT)
  expectedDate    DateTime?           @db.Date
  orderedAt       DateTime?
  receivedAt      DateTime?
  notes           String?
  createdByUserId String?

  items PurchaseOrderItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, status])
  @@index([supplierId])
  @@map("purchase_order")
}

model PurchaseOrderItem {
  id               String        @id @default(cuid())
  purchaseOrderId  String
  purchaseOrder    PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)
  inventoryId      String
  inventory        Inventory     @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  quantity         Decimal       @db.Decimal(12, 3)
  receivedQuantity Decimal       @default(0) @db.Decimal(12, 3)
  unitCost         Decimal       @db.Decimal(10, 2)

  @@unique([purchaseOrderId, inventoryId])
  @@index([inventoryId])
  @@map("purchase_order_item")
}

// Money paid to a supplier. Outstanding balance = value received on purchase orders minus these payments.
model SupplierPayment {
  id               String         @id @default(cuid())
  organizationId   String
  organization     Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  supplierId       String
  supplier         Supplier       @relation(fields: [supplierId], references: [id], onDelete: Restrict)
  amount           Decimal        @db.Decimal(12, 2)
  paidAt           DateTime       @db.Date
  method           PaymentMethod?
  note             String?
  recordedByUserId String?

  createdAt DateTime @default(now())

  @@index([supplierId])
  @@index([organizationId])
  @@map("supplier_payment")
}

// Chunk 18.1 — Recipe / BOM. One recipe per Food Item; an Inventory item IS the
// ingredient (AJ, 2026-10-04), so there is no separate Ingredient table and no
// second stock count to keep in step. Quantities are for `yieldServings`
// servings and scale linearly (src/modules/recipes/recipe-math.ts).
model Recipe {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  menuItemId     String       @unique
  menuItem       MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  yieldServings  Decimal      @default(1) @db.Decimal(10, 2)
  notes          String?

  ingredients RecipeIngredient[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("recipe")
}

// No `organizationId` of its own — cascades off its Recipe. Restrict on the
// Inventory side: an item used in a recipe cannot be deleted silently.
model RecipeIngredient {
  id          String    @id @default(cuid())
  recipeId    String
  recipe      Recipe    @relation(fields: [recipeId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  quantity    Decimal   @db.Decimal(12, 3)

  @@unique([recipeId, inventoryId])
  @@index([inventoryId])
  @@map("recipe_ingredient")
}

// No `organizationId` of its own — cascades automatically (DB-level
// onDelete: Cascade) off its parent Inventory row, same pattern as
// MenuMenuItem/EventTypeMenu (see tenant-scoped-models.ts's comment).
model InventoryTransaction {
  id          String                   @id @default(cuid())
  inventoryId String
  inventory   Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryTransactionType
  // Always a positive magnitude for STOCK_IN/STOCK_OUT; a signed delta
  // (can be negative) for ADJUSTMENT — see `recordStockTransaction`'s
  // stock-quantity math for the exact rules each type applies.
  quantity    Decimal                  @db.Decimal(12, 2)
  note        String?
  // Chunk 18.4 — set when an order's recipe-based stock take wrote this row (a plain id, no FK, so the ledger outlives the order).
  orderId     String?

  // Nullable/SetNull so the ledger entry survives actor deletion, same
  // rationale as AuditLog.actorUserId.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@index([orderId])
  @@map("inventory_transaction")
}

// Chunk 9 — CRM Core: Customer, Event. Lead/Enquiry merged into Customer
// (2026-09-17, AJ) — one record per person, not two: `isEnquiry`/`leadSource`
// carry the lightweight lead-capture info directly on Customer instead of a
// separate Enquiry entity, and whether someone is a Lead or a Customer is
// derived from Order.customerId (see `getCustomerStatus`/`listCustomers` in
// customer.ts), not a synced column that could drift.
//
// Updated doc §11's "Add New Lead" source options.
enum EnquiryLeadSource {
  STOREFRONT
  MANUAL_ENTRY
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  ADVERTISEMENT
  COLD_CALL
  NETWORKING
  OTHER
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  notes          String?
  isActive       Boolean      @default(true)

  // "Is this an enquiry?" toggle — when true, `leadSource`/`notes` above
  // hold the Lead Information captured at intake. Status (Lead vs Customer)
  // is derived from whether any Order references this Customer, not stored
  // here — see the module-level comment above.
  isEnquiry  Boolean            @default(false)
  leadSource EnquiryLeadSource?

  // Storefront intake consent (Chunk 12, 2026-09-25) — the visitor's tick on
  // step 1's "keep me updated on WhatsApp/email, incl. offers" box. Gates
  // promotional retargeting only; contacting someone about the request they
  // started doesn't depend on it.
  marketingConsent   Boolean   @default(false)
  marketingConsentAt DateTime?
  // Chunk 16: set when the customer uses the unsubscribe link in an email; consent is switched off with it.
  marketingOptOutAt  DateTime?

  events           Event[]
  orders           Order[]
  quotations       Quotation[]
  storefrontDrafts StorefrontDraft[]
  noteEntries      CustomerNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added 2026-09-17 for Chunk 11's phone-based customer lookup
  // (findCustomerByPhone) — verified no existing duplicate
  // (organizationId, phone) pairs in dev data before adding.
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("customer")
}

// Matches the Events Dashboard's own status filter values exactly (Updated
// doc §9: All Status/Pending/Processing/Completed/Cancelled).
enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  // Nullable — only one default Kitchen is usable until Chunk 23's
  // multi-location UI; SetNull rather than Restrict since a Kitchen going
  // away shouldn't block deleting/keeping the Event itself.
  assignedKitchenId String?
  assignedKitchen   Kitchen? @relation(fields: [assignedKitchenId], references: [id], onDelete: SetNull)

  name       String
  // Date range, not a single date (Updated doc's multi-day event support) —
  // Chunk 10's Meal Planning depends on this.
  startDate  DateTime
  endDate    DateTime
  venue      String?
  guestCount Int?
  notes      String?
  status     EventStatus @default(PENDING)

  // Populated once the caterer chooses "Yes, create event" after Order
  // creation (Updated doc §8, Chunk 10 Group 10.6). SetNull, not Restrict —
  // deleting an Order should never block deleting/keeping its Event, it
  // just unlinks it. Nullable/non-unique: an Event can exist with no Order
  // yet, and nothing stops several Events sharing one Order (e.g. a
  // multi-day booking with a distinct operational day each) — see the
  // Order/Event judgment call in dev plans/index.md #14.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  requiredInventory EventRequiredInventory[]
  staffAssignments  StaffAssignment[]
  // Chunk 11 — at most one MenuSelection per Event (MenuSelection.eventId
  // is @unique).
  menuSelection     MenuSelection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([eventTypeId])
  @@map("event")
}

// No `organizationId` of its own — cascades automatically off its parent
// Event row, same pattern as MenuMenuItem/EventTypeMenu/InventoryTransaction.
model EventRequiredInventory {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  quantity    Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([eventId, inventoryId])
  @@index([eventId])
  @@index([inventoryId])
  @@map("event_required_inventory")
}

// Chunk 10 — Sales Pipeline: Order (Quotation, Group 10.1, deferred to a
// later pass per AJ — Order is scoped here to be creatable directly, matching
// the updated doc's order-first flow; a `quotationId` FK gets added on top
// of this same table whenever Quotation lands, same "leave it out until the
// referenced model exists" convention as Chunk 9's `Event.orderId`).

// Order lifecycle (AJ, 2026-09-26). Driven by the menu-approval and kitchen
// workflow (see menu-approval.ts's syncOrderStatus), and still overridable
// by hand on the order form. Menu Approvals is a work queue on top of this,
// not a lifecycle of its own.
enum OrderStatus {
  PENDING_REVIEW
  AWAITING_CUSTOMER_APPROVAL
  APPROVED
  SENT_TO_KITCHEN
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Updated doc §6's five meal slots.
enum MealType {
  BREAKFAST
  LUNCH
  HITEA
  DINNER
  OTHER
}

// Shared by OrderItem (and, later, QuotationItem) — a catalog line item can
// be a whole priced Menu, a single MenuItem, or an AddOn; exactly one of
// menuId/menuItemId/addOnId is set per row, matching which itemType this is.
enum OrderItemType {
  MENU
  MENU_ITEM
  ADD_ON
}

// Single = one Menu for the whole Order (today's default flow). Multi = one
// Event with different Menus for different meal slots (MealPlanEntry.menuId)
// — day count does not determine this; it's an explicit, overridable choice
// on the Order (src/app/(app)/orders/_components/order-form.tsx).
enum OrderKind {
  SINGLE
  MULTI
}

// Chunk 11 Group 11.2 — the intake form's "Venue Type" dropdown options
// (2026-09-17 reference form).
enum VenueType {
  CLUBHOUSE
  HOTEL
  BANQUET_HALL
  RESORT
  HOME
  OFFICE
  OTHER
}

// Chunk 11 Group 11.2 — the intake form's "Vehicle Access" dropdown options.
enum VehicleAccessType {
  VEHICLE_AND_PARKING
  VEHICLE_NO_PARKING
  NO_VEHICLE_ACCESS
  MANUAL_LOADING_REQUIRED
}

// Create Order's "Pricing Information" section (2026-09-19). STANDARD reads
// straight off the Menu's own rates (childPricingMenu below, plus each
// MealPlanEntry's own menu for Multi Order) — no new fields needed for that
// case. INDIVIDUAL overrides all three per-guest rates for this one order
// only, via the individual*Rate fields below; it never touches Menu Type
// itself. This is a distinct concept from `individualPricingEnabled`, which
// is the pre-existing per-meal-slot Meal Planning price override.
enum PricingMethod {
  STANDARD
  INDIVIDUAL
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Nullable/SetNull, unlike Event's required/Restrict eventTypeId — an
  // Order's own event-type is lightweight categorization, not something
  // Menu Selection logic depends on the way Event's does.
  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  // Chunk 10 Group 10.1 — set only when this Order was converted from an
  // Accepted Quotation (src/modules/quotations/quotation.ts's
  // `convertQuotationToOrder`); null for an Order created directly. Unique:
  // a Quotation converts into at most one Order. SetNull so deleting the
  // Quotation later never deletes the Order it already produced.
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  // Create Order redesign (2026-09-20) — every meal already assigns its own
  // Menu via MealPlanEntry.menuId regardless of this value now (see that
  // model's own comment). orderKind is purely a UI/reporting distinction:
  // SINGLE renders Meal Planning as one continuous event even across
  // several days; MULTI groups the same per-day data into visually distinct
  // "Event 1 / Event 2…" blocks (one per date) in order-form.tsx. Explicit,
  // not inferred from date range alone — see that file's confirmation-
  // dialog flow for switching between the two.
  orderKind OrderKind @default(SINGLE)

  // Human-readable, per-tenant sequential label (e.g. "AJ-0001"), assigned
  // once at creation from Organization.orderNumberPrefix/NextValue/Padding —
  // immutable afterward, unlike the pricing fields below. Nullable because
  // Orders created before this feature shipped have none.
  orderNumber String?

  // Updated doc §5 "Event Information" — captured directly on the Order,
  // independent of whether a formal Event row exists yet (Group 10.6).
  eventStartDate DateTime
  eventEndDate   DateTime
  venue          String?
  eventAddress   String?

  // Chunk 11 Group 11.2 (2026-09-17) — the customer-facing event-details
  // intake form's "Menu Preference" and "Event Time" fields, captured here
  // rather than a new model, following this same section's existing
  // precedent of storing intake fields directly on Order. eventMealType
  // reuses MealType (the same enum MealPlanEntry uses) but is independent of
  // it — this is the single meal slot the *whole event* is for, not a
  // per-day Multi Order slot.
  menuPreference FoodType?
  eventMealType  MealType?

  // Chunk 11 Group 11.2 — "Venue & Delivery Details" section of the intake
  // form. `venue`/`eventAddress` above already cover the free-text venue
  // name/full address; these are the additional structured fields the
  // reference form (AJ, 2026-09-17) collects on top of them.
  venueType               VenueType?
  venueDoorNumber         String?
  venueTower              String?
  venueFloor              String?
  venueHallName           String?
  venueLandmark           String?
  venueContactName        String?
  venueContactPhone       String?
  venueAccessInstructions String?
  vehicleAccess           VehicleAccessType?
  liveCounterAvailable    Boolean?

  // "Venue & Delivery Details" section, Create Order redesign (2026-09-19).
  // Distinct from venueAccessInstructions above (that field is the
  // customer-facing intake form's own free-text access note; these two are
  // the admin Create Order form's separate Delivery/Cooking instruction
  // fields, per AJ's explicit ask for two distinct textareas).
  gasElectricAvailable    Boolean?
  deliveryInstructions    String?
  cookingInstructions     String?
  // When the customer sent their Venue & Delivery details on the approval link (2026-10-02); null until then.
  venueDetailsSubmittedAt DateTime?

  // Participant Information (Group 10.3) — lets pricing reflect actual
  // guest composition. `totalParticipants` is a UI-suggested default
  // (adultCount+childBelow5Count+child5To10Count) but stored independently/
  // overridable. Children are split by age band (below-5 / 5-10) rather than
  // one flat count, since Menu Type pricing rates now differ by band.
  adultCount        Int?
  childBelow5Count  Int?
  child5To10Count   Int?
  totalParticipants Int?

  // Chunk 18.4 — set once, when the recipe-based stock for this order was confirmed and taken (at the kitchen hand-off).
  stockDeductedAt       DateTime?
  stockDeductedByUserId String?

  // Children Guests & Pricing (order-level, all order kinds) — which Menu's
  // child rates apply to childBelow5Count/child5To10Count above when
  // pricingMethod is STANDARD. Server-derived (deriveStandardChildPricingMenuId
  // in order.ts) from the first Meal Planning entry's own menuId, in
  // date/mealType order — never a client-submitted value, there's no
  // separate "pick a menu for children" selector. SetNull (not Restrict) —
  // deleting a Menu still referenced here shouldn't block or cascade the Order,
  // same precedent as OrderItem.menuId/MealPlanEntry.menuId.
  childPricingMenuId String?
  childPricingMenu   Menu?   @relation(fields: [childPricingMenuId], references: [id], onDelete: SetNull)

  // "Pricing Information" section (2026-09-19) — STANDARD (default) prices
  // off childPricingMenu (derived from the first Meal Planning entry's own
  // Menu — see deriveStandardChildPricingMenuId), same as before this field
  // existed. INDIVIDUAL overrides both per-guest child rates for this order
  // only; the individual*Rate fields are ignored when STANDARD. Create Order
  // redesign (2026-09-20): each child band's individual rate now carries its
  // own Per Plate/Percentage type (individual*PricingType, reusing the same
  // ChildPricingType enum Menu.child5To10PricingType uses) instead of always
  // being a flat amount — Percentage is computed against that same derived
  // Menu's pricePerPlate.
  pricingMethod                    PricingMethod     @default(STANDARD)
  individualAdultRate              Decimal?          @db.Decimal(12, 2)
  individualChildBelow5Rate        Decimal?          @db.Decimal(12, 2)
  individualChildBelow5PricingType ChildPricingType?
  individualChild5To10Rate         Decimal?          @db.Decimal(12, 2)
  individualChild5To10PricingType  ChildPricingType?

  // Meal Planning (Group 10.4) — when true, each MealPlanEntry's own
  // `price` is added into `subtotal`; when false, meal selections are
  // purely operational (which meals, which days) and only `items`
  // (Products & Menu Items) drive pricing.
  individualPricingEnabled Boolean @default(false)

  // Pricing (PRD §21) — `subtotal`/`total`/`balance` are kept in sync by
  // `recalculateOrderTotals` (src/modules/orders/order.ts) whenever
  // mealPlanEntries/discount/advance change, not recomputed ad hoc by every
  // reader. `childrenCharge` is the live-recomputed Children Guests &
  // Pricing contribution folded into `subtotal`. Taxes removed from Create
  // Order entirely (2026-09-20, AJ's explicit ask) — no replacement field;
  // GST/tax handling isn't part of this flow.
  subtotal           Decimal @default(0) @db.Decimal(12, 2)
  childrenCharge     Decimal @default(0) @db.Decimal(12, 2)
  // "Order Details" section (2026-09-19) — editable pricing add-ons folded
  // into `total` by recalculateOrderTotals alongside discount.
  transportationCost Decimal @default(0) @db.Decimal(12, 2)
  otherCharges       Decimal @default(0) @db.Decimal(12, 2)
  discount           Decimal @default(0) @db.Decimal(12, 2)
  total              Decimal @default(0) @db.Decimal(12, 2)
  advance            Decimal @default(0) @db.Decimal(12, 2)
  balance            Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus         OrderPaymentStatus @default(UNPAID)
  status                OrderStatus        @default(PENDING_REVIEW)
  notes                 String?
  // "Order Details" section — a second, kitchen-facing note distinct from
  // the customer/admin-facing `notes` above.
  kitchenNotes          String?
  // Set whenever the kitchen notes change; the prep sheet shows it (AJ, 2026-09-30: a timestamp, no author).
  kitchenNotesUpdatedAt DateTime?

  items           OrderItem[]
  mealPlanEntries MealPlanEntry[]
  statusChanges   StatusChange[]
  events          Event[]
  invoices        Invoice[]
  payments        Payment[]
  expenses        Expense[]
  paymentLinks    PaymentLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("order")
}

// No `organizationId` of its own — cascades off its parent Order row.
model OrderItem {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  // Create Order redesign (2026-09-20) — every OrderItem now belongs to the
  // meal it was picked for (the removed "Products & Menu Items" section was
  // the last source of a whole-order item with this left null). Cascade: a
  // meal's items only make sense scoped to it, so unchecking that meal
  // removes them along with its MealPlanEntry row. Quotations keep their own
  // separate, unaffected whole-order item model.
  mealPlanEntryId String?
  mealPlanEntry   MealPlanEntry? @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)

  // Snapshotted at add-time — survives the catalog item being renamed,
  // repriced, or deleted later without silently rewriting a past Order.
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  // Pricing rule (AJ, 2026-09-30): a meal costs its Menu's per-plate price x
  // guests, so a dish inside the menu is included and adds nothing. Only an
  // Extra dish (charged per guest) or an add-on moves the price — see
  // src/modules/orders/meal-pricing.ts.
  isExtra Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_item")
}

// No `organizationId` of its own — cascades off its parent Order row.
// Existence of a row = that (date, mealType) is selected for this Order;
// there's no separate boolean to go out of sync with row presence.
model MealPlanEntry {
  id       String   @id @default(cuid())
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date     DateTime
  mealType MealType
  // Only meaningful (and only ever set) when Order.individualPricingEnabled.
  price    Decimal? @db.Decimal(10, 2)

  // Create Order redesign (2026-09-20) — every meal, regardless of
  // Order.orderKind, assigns its own Menu (required before food items can be
  // chosen — see order-form.tsx's meal-card flow) and picks items from it.
  // Previously Multi-order-only; Single Order used to share one order-wide
  // Menu via the now-removed "Products & Menu Items" section instead.
  // Children Guests & Pricing moved to being order-level only (Order's own
  // childBelow5Count/child5To10Count + pricingMethod) — the per-slot
  // childBelow5Count/child5To10Count columns this model briefly had are gone.
  menuId String?
  menu   Menu?       @relation(fields: [menuId], references: [id], onDelete: SetNull)
  // Items chosen from that Menu specifically for this meal — see
  // OrderItem.mealPlanEntryId.
  items  OrderItem[]

  createdAt DateTime @default(now())

  @@unique([orderId, date, mealType])
  @@index([orderId])
  @@map("meal_plan_entry")
}

// Chunk 10 Group 10.1 — Quotation (deferred from the initial Chunk 10 pass,
// built once Order already existed, so `Order.quotationId` above is a real
// `@relation` from day one rather than another bare-column-then-migrate).

// PRD §20's exact 7-state list. Customer-facing transitions (VIEWED/
// CHANGES_REQUESTED/ACCEPTED/REJECTED) happen via the public token page,
// not the admin UI.
enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Nullable, same reasoning as Order.eventTypeId — a Quotation may predate
  // firm event details.
  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  // Nullable, unlike Order's required date range — a Quotation can be sent
  // before dates are finalized; `convertQuotationToOrder` requires both to
  // be set (Order itself requires them) and throws a clear error otherwise.
  eventStartDate DateTime?
  eventEndDate   DateTime?
  venue          String?
  eventAddress   String?

  // Item-picker parity with Order (2026-09-28) — same fields, same meaning,
  // as Order's own (see that model's comments for the full rationale).
  // Deliberately excluded: Order's structured venue/delivery block
  // (venueType/venueDoorNumber/.../vehicleAccess/gasElectricAvailable/
  // deliveryInstructions/cookingInstructions) — Quotation keeps only the
  // plain venue/eventAddress text fields above. Also excluded:
  // individualAdultRate (declared on Order but never read/written anywhere).
  orderKind OrderKind @default(SINGLE)

  menuPreference FoodType?

  adultCount        Int?
  childBelow5Count  Int?
  child5To10Count   Int?
  totalParticipants Int?

  // Server-derived (deriveStandardChildPricingMenuId, shared with Order) from
  // the first Meal Planning entry's own menuId — never client-submitted.
  childPricingMenuId String?
  childPricingMenu   Menu?   @relation(fields: [childPricingMenuId], references: [id], onDelete: SetNull)

  pricingMethod                    PricingMethod     @default(STANDARD)
  individualChildBelow5Rate        Decimal?          @db.Decimal(12, 2)
  individualChildBelow5PricingType ChildPricingType?
  individualChild5To10Rate         Decimal?          @db.Decimal(12, 2)
  individualChild5To10PricingType  ChildPricingType?

  individualPricingEnabled Boolean @default(false)

  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  terms           String?
  notes           String?
  // Set by the customer's own Request Changes / Reject action on the
  // public token page — distinct from `notes`, which is the caterer's own.
  customerMessage String?

  // Pricing (PRD §20 — Quotation's own field list is a superset of Order's:
  // additionalCharges/deliveryCharges have no Order equivalent, matching
  // Order's leaner PRD §21 field list; convertQuotationToOrder folds both
  // into the new Order's `taxes` so the converted total still matches).
  // childrenCharge mirrors Order's — the live Children Guests & Pricing
  // contribution folded into subtotal by recalculateQuotationTotals.
  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  childrenCharge    Decimal @default(0) @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  taxes             Decimal @default(0) @db.Decimal(12, 2)
  additionalCharges Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharges   Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @default(0) @db.Decimal(12, 2)

  items           QuotationItem[]
  mealPlanEntries QuotationMealPlanEntry[]
  order           Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@map("quotation")
}

// No `organizationId` of its own — cascades off its parent Quotation row.
model QuotationItem {
  id          String        @id @default(cuid())
  quotationId String
  quotation   Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemType    OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  // Item-picker parity with Order (2026-09-28) — mirrors OrderItem.mealPlanEntryId.
  // Null only for pre-parity rows left over from the old flat picker; every
  // item added through the new Meal Planning UI belongs to a meal slot.
  mealPlanEntryId String?
  mealPlanEntry   QuotationMealPlanEntry? @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)

  // Snapshotted at add-time, same convention as OrderItem — and the exact
  // values `convertQuotationToOrder` copies onto the new OrderItem rows
  // untouched, so an accepted quotation's price can never silently drift
  // from a later catalog change.
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  // Mirrors OrderItem.isExtra — copied onto the Order on conversion.
  isExtra Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@map("quotation_item")
}

// Item-picker parity with Order (2026-09-28) — exact mirror of MealPlanEntry,
// scoped to Quotation instead of Order. No `organizationId` of its own —
// cascades off its parent Quotation row, same precedent as MealPlanEntry.
model QuotationMealPlanEntry {
  id          String    @id @default(cuid())
  quotationId String
  quotation   Quotation @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  date        DateTime
  mealType    MealType
  // Only meaningful (and only ever set) when Quotation.individualPricingEnabled.
  price       Decimal?  @db.Decimal(10, 2)

  menuId String?
  menu   Menu?           @relation(fields: [menuId], references: [id], onDelete: SetNull)
  items  QuotationItem[]

  createdAt DateTime @default(now())

  @@unique([quotationId, date, mealType])
  @@index([quotationId])
  @@map("quotation_meal_plan_entry")
}

// Chunk 11 Groups 11.2/11.3 (2026-09-17) — Menu Selection + Approval
// Workflow. AJ's redesign (see dev plans/chunk-11-menu-selection-approval-
// kitchen.md): no per-event link/token — the customer reaches this through
// Chunk 8's tenant-wide Public Menu Link, identified by phone (Group 11.2),
// with a brand-new Event created per submission. One MenuSelection per
// Event (MenuSelection.eventId is @unique).

// PRD §29's exact 9-state list.
enum MenuSelectionStatus {
  DRAFT
  SENT_TO_CUSTOMER
  CUSTOMER_REVIEWING
  CHANGES_REQUESTED
  CUSTOMER_APPROVED
  FINAL_LOCKED
}

// Group 11.5 — PRD §34's Kitchen Display System status, distinct from
// MenuSelectionStatus above (the approval workflow). Only meaningful once
// `status` reaches FINAL_LOCKED; the kitchen team advances it manually,
// one stage at a time, from the Kitchen Dashboard.
enum KitchenProductionStatus {
  PENDING
  IN_PREPARATION
  READY
  DELIVERED
  CANCELLED
}

model MenuSelection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status MenuSelectionStatus @default(DRAFT)

  // Group 11.5 — kitchen team's own manual production tracking (§34), only
  // acted on once `status` is FINAL_LOCKED.
  kitchenProductionStatus KitchenProductionStatus @default(PENDING)

  // Bumped each time a post-approval change snapshots the prior state into
  // a new MenuVersion (§30) — the version number `items` below currently
  // represents.
  currentVersion Int @default(1)

  // Set by the customer's/kitchen's own Request Changes action — kept
  // separate per side so neither overwrites the other's comment.
  customerRequestNote String?
  kitchenRequestNote  String?

  submittedAt DateTime?
  lockedAt    DateTime?

  // Chunk 12 — the Menu the customer picked on the storefront (null for a
  // Custom Menu, where they hand-pick dishes and the kitchen quotes the
  // per-plate price afterwards).
  chosenMenuId        String?
  chosenMenu          Menu?    @relation("MenuSelectionChosenMenu", fields: [chosenMenuId], references: [id], onDelete: SetNull)
  isCustomMenu        Boolean  @default(false)
  // Set by the kitchen while reviewing a Custom Menu.
  customPricePerPlate Decimal? @db.Decimal(10, 2)

  items    MenuSelectionItem[]
  versions MenuVersion[]
  notes    MenuApprovalNote[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu_selection")
}

enum MenuApprovalNoteAuthor {
  CUSTOMER
  KITCHEN
  TEAM
}

// Every note on a menu approval, kept in order (AJ, 2026-09-30) — the two
// request-note fields on MenuSelection only ever held the latest one.
model MenuApprovalNote {
  id              String        @id @default(cuid())
  organizationId  String
  menuSelectionId String
  menuSelection   MenuSelection @relation(fields: [menuSelectionId], references: [id], onDelete: Cascade)

  // The menu version the note was written against (null if unknown).
  versionNumber Int?
  authorType    MenuApprovalNoteAuthor
  authorName    String?
  body          String

  createdAt DateTime @default(now())

  @@index([menuSelectionId])
  @@index([organizationId])
  @@map("menu_approval_note")
}

enum StatusChangeSubject {
  ORDER
  MENU_APPROVAL
}

enum StatusChangeSource {
  AUTOMATIC
  MANUAL
}

// Every change of an order's or its menu approval's status, automatic or by hand (AJ, 2026-09-30). A manual change
// always carries a reason; the record is what shows in the Status history on the Order and Menu Approvals pages.
model StatusChange {
  id              String              @id @default(cuid())
  organizationId  String
  orderId         String
  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuSelectionId String?
  subject         StatusChangeSubject
  fromStatus      String?
  toStatus        String
  source          StatusChangeSource
  // What caused an automatic change, e.g. "Menu sent to customer".
  trigger         String?
  reason          String?
  actorUserId     String?
  actorName       String?

  createdAt DateTime @default(now())

  @@index([orderId, createdAt])
  @@index([organizationId])
  @@map("status_change")
}

// No `organizationId` of its own — cascades off its parent MenuSelection
// row, same pattern as OrderItem/QuotationItem. Represents the *current*
// live selection; §30's versioning snapshots this into MenuVersionItem
// before it's changed again once no longer DRAFT.
model MenuSelectionItem {
  id              String        @id @default(cuid())
  menuSelectionId String
  menuSelection   MenuSelection @relation(fields: [menuSelectionId], references: [id], onDelete: Cascade)
  itemType        OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  // Snapshotted at add-time, same convention as OrderItem/QuotationItem.
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  // Always 1 — Menu Selection is add/remove only, never a quantity entry.
  quantity  Int     @default(1)
  // Picked beyond its category's max-selection; priced price x guests.
  isExtra   Boolean @default(false)

  createdAt DateTime @default(now())

  @@index([menuSelectionId])
  @@map("menu_selection_item")
}

// A frozen snapshot of MenuSelection's items at a point in time — created
// whenever a post-approval change happens (§30: "any post-approval change
// creates a new MenuVersion, never mutates in place"). `status` is
// MenuSelection's status at the moment this version was captured.
model MenuVersion {
  id              String        @id @default(cuid())
  menuSelectionId String
  menuSelection   MenuSelection @relation(fields: [menuSelectionId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        MenuSelectionStatus
  note          String?

  // Created each time the team sends the menu to the customer. `snapshot` is
  // exactly what the customer's approval page shows (meals, items, guests,
  // total) — approving a version approves that frozen content, not whatever
  // the order looks like later. `supersededAt` is set when a newer version is
  // sent; only the latest version can be approved.
  snapshot     Json?
  sentAt       DateTime?
  supersededAt DateTime?

  items MenuVersionItem[]

  createdAt DateTime @default(now())

  @@unique([menuSelectionId, versionNumber])
  @@index([menuSelectionId])
  @@map("menu_version")
}

// No `organizationId` of its own — cascades off its parent MenuVersion row.
model MenuVersionItem {
  id            String        @id @default(cuid())
  menuVersionId String
  menuVersion   MenuVersion   @relation(fields: [menuVersionId], references: [id], onDelete: Cascade)
  itemType      OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  @@index([menuVersionId])
  @@map("menu_version_item")
}

enum StorefrontDraftStatus {
  IN_PROGRESS
  COMPLETED
}

// Chunk 12 (2026-09-25) — one row per visitor journey through the public
// storefront's multi-step order flow. Created as soon as step 1 (contact +
// event details) is submitted, autosaved per step, marked COMPLETED when the
// final Submit creates the real Order. "Abandoned" isn't stored: it's an
// IN_PROGRESS draft idle for 30+ minutes, derived at read time (no cron).
// Purged after 90 days; the Customer (a Lead with 0 orders) outlives it.
model StorefrontDraft {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)

  status         StorefrontDraftStatus @default(IN_PROGRESS)
  // Furthest step unlocked, 1-3 (Event Details, Build Your Menu, Review & Submit).
  currentStep    Int                   @default(1)
  data           Json
  orderId        String?
  lastActivityAt DateTime              @default(now())
  completedAt    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status, lastActivityAt])
  @@map("storefront_draft")
}

// --- Chunk 14: Billing, Invoicing & Payments (PRD §38-40) ---
// Every kitchen collects its own money (its own Razorpay account and/or UPI id);
// Platterly never holds it. Order.advance / balance / paymentStatus are derived from
// CONFIRMED payments by src/modules/payments/payment.ts once an order has any.

enum InvoiceType {
  INVOICE
  RECEIPT
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  CANCELLED
}

enum GstType {
  CGST_SGST
  IGST
}

enum PaymentType {
  ADVANCE
  PARTIAL
  FINAL
}

enum PaymentMethod {
  UPI
  CARD
  NET_BANKING
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
}

enum PaymentSource {
  MANUAL
  RAZORPAY
  UPI_QR
}

model Invoice {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)

  type   InvoiceType   @default(INVOICE)
  number String
  status InvoiceStatus @default(DRAFT)

  issueDate DateTime  @default(now())
  dueDate   DateTime?

  // Snapshots, so an invoice never changes when the customer or business profile does.
  customerName      String
  customerPhone     String?
  customerEmail     String?
  customerAddress   String?
  businessName      String
  businessAddress   String?
  businessGstNumber String?

  // Prices on an order include GST, so GST is carved out of the total (the invoice total always equals the order total).
  gstEnabled   Boolean @default(false)
  gstType      GstType @default(CGST_SGST)
  gstRate      Decimal @default(0) @db.Decimal(5, 2)
  taxableValue Decimal @default(0) @db.Decimal(12, 2)
  cgst         Decimal @default(0) @db.Decimal(12, 2)
  sgst         Decimal @default(0) @db.Decimal(12, 2)
  igst         Decimal @default(0) @db.Decimal(12, 2)
  total        Decimal @default(0) @db.Decimal(12, 2)

  terms  String?
  notes  String?
  sentAt DateTime?

  // A RECEIPT belongs to exactly one payment.
  receiptForPaymentId String?  @unique
  receiptForPayment   Payment? @relation("PaymentReceipt", fields: [receiptForPaymentId], references: [id], onDelete: SetNull)

  items    InvoiceItem[]
  payments Payment[]     @relation("InvoicePayments")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, number])
  @@index([organizationId, orderId])
  @@map("invoice")
}

model InvoiceItem {
  id          String  @id @default(cuid())
  invoiceId   String
  invoice     Invoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  detail      String?
  hsnSac      String?
  quantity    Decimal @db.Decimal(12, 2)
  rate        Decimal @db.Decimal(12, 2)
  amount      Decimal @db.Decimal(12, 2)
  sortOrder   Int     @default(0)

  @@index([invoiceId])
  @@map("invoice_item")
}

model PaymentLink {
  id              String       @id @default(cuid())
  organizationId  String
  organization    Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId         String
  order           Order        @relation(fields: [orderId], references: [id], onDelete: Cascade)
  invoiceId       String?
  type            PaymentType
  // The amount the link asks for; a payment can never exceed the order's balance.
  amount          Decimal      @db.Decimal(12, 2)
  createdByUserId String?
  createdAt       DateTime     @default(now())

  payments Payment[]

  @@index([organizationId, orderId])
  @@map("payment_link")
}

model Payment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String
  order          Order        @relation(fields: [orderId], references: [id], onDelete: Restrict)
  invoiceId      String?
  invoice        Invoice?     @relation("InvoicePayments", fields: [invoiceId], references: [id], onDelete: SetNull)
  paymentLinkId  String?
  paymentLink    PaymentLink? @relation(fields: [paymentLinkId], references: [id], onDelete: SetNull)

  amount     Decimal       @db.Decimal(12, 2)
  type       PaymentType
  method     PaymentMethod
  status     PaymentStatus @default(CONFIRMED)
  source     PaymentSource @default(MANUAL)
  receivedAt DateTime      @default(now())
  reference  String?
  note       String?

  // Razorpay's own ids; razorpayPaymentId is unique so a webhook delivered twice makes one payment.
  razorpayOrderId   String?
  razorpayPaymentId String? @unique

  recordedByUserId String?
  confirmedAt      DateTime?

  receipt Invoice? @relation("PaymentReceipt")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, orderId])
  @@index([razorpayOrderId])
  @@map("payment")
}

// A customer's dated notes (AJ, 2026-09-30: "Add Note", each with its author and time), replacing the single
// Customer.notes text. That column stays for the "notes about this lead" field on the create form, which now
// also writes the first note.
model CustomerNote {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  customerId     String
  customer       Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  body           String
  authorUserId   String?
  authorName     String
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId, customerId])
  @@map("customer_note")
}

enum ExpenseCategory {
  FOOD
  LABOUR
  TRANSPORT
  EQUIPMENT
  VENUE
  MISC
  // Company (overhead) expenses, not tied to an order (AJ, 2026-10-03). MISC is shared by both kinds.
  RENT
  SALARIES
  UTILITIES
  MARKETING
  MAINTENANCE
  LICENCES_FEES
}

// Chunk 15 (PRD §41): what an order's event cost to run, or (orderId null) a company expense such as rent.
// Hangs off the Order, not the hidden Event record (an Event is synced from each Order and may not exist yet).
model Expense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  orderId        String?
  order          Order?       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  category      ExpenseCategory
  amount        Decimal         @db.Decimal(12, 2)
  spentAt       DateTime        @db.Date
  paymentMethod PaymentMethod?
  supplierName  String?
  // Chunk 18.2 — optional pick from the supplier list; supplierName keeps the name as typed or as it was when picked.
  supplierId    String?
  supplier      Supplier?       @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes         String?

  recordedByUserId String?

  // Set when a RecurringExpense made this row; the pair is unique so a template can never book the same date twice.
  recurringExpenseId String?
  recurringExpense   RecurringExpense?   @relation(fields: [recurringExpenseId], references: [id], onDelete: SetNull)
  attachments        ExpenseAttachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([recurringExpenseId, spentAt])
  @@index([organizationId, orderId])
  @@index([organizationId, spentAt])
  @@map("expense")
}

// A receipt or bill kept with an expense (image or PDF), stored through the storage driver.
model ExpenseAttachment {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  expenseId      String
  expense        Expense      @relation(fields: [expenseId], references: [id], onDelete: Cascade)

  key         String
  url         String
  fileName    String
  contentType String
  sizeBytes   Int

  uploadedByUserId String?
  createdAt        DateTime @default(now())

  @@index([expenseId])
  @@map("expense_attachment")
}

enum RecurrenceFrequency {
  WEEKLY
  MONTHLY
  QUARTERLY
  YEARLY
}

// A company expense that repeats (rent, salaries...). Rows are booked as ordinary Expenses when due, the next time
// the Expenses page loads (no background scheduler exists yet). `lastRunThrough` makes a paused template skip the
// dates it was paused for when it is resumed.
model RecurringExpense {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  category      ExpenseCategory
  amount        Decimal             @db.Decimal(12, 2)
  frequency     RecurrenceFrequency
  startDate     DateTime            @db.Date
  endDate       DateTime?           @db.Date
  paymentMethod PaymentMethod?
  supplierName  String?
  // Chunk 18.2 — optional pick from the supplier list; supplierName keeps the name as typed or as it was when picked.
  supplierId    String?
  supplier      Supplier?           @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  notes         String?

  isActive       Boolean   @default(true)
  lastRunThrough DateTime? @db.Date

  createdByUserId String?
  expenses        Expense[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("recurring_expense")
}
