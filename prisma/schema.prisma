// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  isSuperAdmin Boolean @default(false)

  notificationsReceived Notification[]
  auditLogsActedOn      AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  branches    Branch[]
  kitchens    Kitchen[]
  stores      Store[]

  notifications      Notification[]
  whatsAppMessages   WhatsAppMessage[]
  auditLogs          AuditLog[]
  secureAccessTokens SecureAccessToken[]
  settings           TenantSetting[]

  // --- Chunk 3 Group 3.2: Super Admin tenant management (PRD §8) ---
  status          TenantStatus @default(ACTIVE)
  ownerName       String?
  contactPhone    String?
  contactEmail    String?
  gstNumber       String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  // Chunk 8's self-service limit is 2 free changes to `slug`; a Super Admin
  // can force further changes once this is exhausted (Group 3.2). The slug
  // column doubles as both the Better-Auth org slug and the public
  // storefront slug — there is only one.
  slugChangeCount Int          @default(0)

  // --- Chunk 4 Group 4.2: Self-serve onboarding business profile ---
  // Extends the same Organization row Chunk 3 already put address/GST/
  // contact fields on, rather than a separate BusinessProfile table —
  // avoids two places storing overlapping tenant profile data.
  businessDescription String?
  websiteUrl          String?
  instagramUrl        String?
  facebookUrl         String?
  gstShowOnInvoices   Boolean? @default(false)

  // Set only when the onboarding wizard's final "Complete Setup" step
  // succeeds — never by Skip, and never by a later Settings save. Drives
  // the Dashboard's "finish your profile" nudge banner.
  onboardingCompletedAt DateTime?

  subscriptions Subscription[]

  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  menus          Menu[]
  menuPackages   MenuPackage[]

  @@unique([slug])
  @@map("organization")
}

// Chunk 3 Group 3.2 — Suspend/Activate/Deactivate are three distinct admin
// actions (PRD §8.2), not two independent booleans. No hard-delete path: an
// Organization's FKs cascade into its own AuditLog, so a literal delete
// would destroy the record of the very action deleting it.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // Chunk 5 Group 5.2 — reversible "disable a teammate" state. Better Auth's
  // own API only offers a hard-delete `removeMember`; this is the softer
  // state that requireActiveOrganization()/requireOrg() enforce, locking a
  // disabled member out of every caterer-facing route without removing them.
  disabledAt DateTime?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- App-level models (not owned by Better Auth) ---
// Branch/Kitchen/Store hierarchy, PRD §47: Tenant(Organization) -> Branch ->
// Kitchen/Store -> Users/Inventory/Events. Schema now, multi-location UI
// later (Chunk 23) — every table below still carries `organizationId`
// directly (not just via Branch) so tenant-isolation queries never need a
// join to be enforced (PRD §54-55).

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  kitchens Kitchen[]
  stores   Store[]

  @@index([organizationId])
  @@map("branch")
}

model Kitchen {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("kitchen")
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("store")
}

// --- Chunk 2: Cross-Cutting Platform Service Interfaces ---
// Interfaces many later, unrelated chunks call — "interface now, integration
// later" (same pattern as auth's pluggable strategy from Chunk 1). Real
// WhatsApp/ZeptoMail/Push/SMS providers land in Chunk 16; these models exist
// so every module from Chunk 9 onward has something to call today.

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
  PUSH
  SMS
}

model Notification {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  event           String
  // Recipients are frequently customers (no `User` row exists for them until
  // Chunk 9's Customer model, and even then Customer isn't a User) — kept as
  // plain fields rather than a hard FK so this interface doesn't have to
  // change shape once Customer exists.
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  payload         Json
  createdAt       DateTime            @default(now())

  logs             NotificationLog[]
  whatsAppMessages WhatsAppMessage[]

  @@index([organizationId])
  @@map("notification")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@map("notification_log")
}

model WhatsAppMessage {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId    String?
  notification      Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  toPhone           String
  body              String
  providerMessageId String?
  status            String        @default("queued")
  createdAt         DateTime      @default(now())

  @@index([organizationId])
  @@map("whatsapp_message")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Audit trail must survive the actor being removed later — SetNull, not
  // Cascade, and the field stays optional.
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  recordType     String
  recordId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([recordType, recordId])
  @@map("audit_log")
}

enum SecureAccessResourceType {
  QUOTATION
  MENU_SELECTION
  INVOICE
  PAYMENT_LINK
}

model SecureAccessToken {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   SecureAccessResourceType
  resourceId     String
  token          String                   @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("secure_access_token")
}

model TenantSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("tenant_setting")
}

// --- Chunk 3 Group 3.3: Subscription Plans (PRD §9, §58) ---
// Definitions only — no live Razorpay billing yet (Chunk 20 reuses Chunk
// 14's integration). `SubscriptionPlan` is a platform-wide catalog (like
// `User`), not tenant-owned data, so it's deliberately exempt from the
// "every app-level model carries organizationId" convention used elsewhere.

model SubscriptionPlan {
  id                String   @id @default(cuid())
  // Stable machine key (e.g. "trial") that Chunk 4's onboarding wizard looks
  // up directly, independent of the human-editable `name`.
  code              String   @unique
  name              String
  description       String?
  isTrial           Boolean  @default(false)
  // Only meaningful when isTrial — the seeded Trial plan uses 7.
  trialDurationDays Int?
  priceMonthly      Decimal? @db.Decimal(10, 2)
  priceAnnual       Decimal? @db.Decimal(10, 2)
  currency          String   @default("INR")

  // PRD §9 limits list. Null means unlimited.
  maxUsers            Int?
  maxEvents           Int?
  maxOrders           Int?
  maxKitchens         Int?
  maxStores           Int?
  maxCustomers        Int?
  maxMenuLinks        Int?
  maxStorageMb        Int?
  maxReports          Int?
  maxWhatsappMessages Int?

  // Retire a plan without breaking Subscription history's FK — never
  // hard-delete (Restrict below would block it anyway once assigned).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  startDate          DateTime           @default(now())
  trialEndsAt        DateTime?
  // Set when superseded/cancelled; null while this is the tenant's current
  // subscription. History is kept, never deleted (immutable per the updated
  // product doc's accounting/audit note, §19).
  endDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("subscription")
}

// --- Chunk 6: Menu & Product Catalog (PRD §22-24, Updated doc §12) ---
// MenuCategory/MenuItem form the org's reusable product catalog ("the
// product information can then be reused in menus and orders" — Updated
// §12). Menu is a separate, named curated grouping of catalog items (e.g.
// "Wedding Silver Menu") consumed by the Public Storefront (Chunk 8) and
// Menu Selection (Chunk 11); MenuPackage is the sellable, priced bundle
// Quotation/Order (Chunk 10) and Meal Planning actually charge against —
// kept distinct from Menu because a single Menu can be priced multiple ways
// (e.g. a Silver and a Gold package drawing from the same item list).

model MenuCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  sortOrder      Int          @default(0)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  items MenuItem[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_category")
}

// Updated doc §12's "Dietary Information" toggle.
enum FoodType {
  VEGETARIAN
  NON_VEGETARIAN
}

// Updated doc §12's "Additional dietary data" -> "Dietary type" field.
// The doc doesn't enumerate its values; this set covers the common Indian
// catering distinctions beyond plain veg/non-veg (a documented judgment
// call, not confirmed with AJ — narrow enough to revisit if it doesn't fit
// real catalog data).
enum DietaryType {
  STANDARD
  JAIN
  VEGAN
  GLUTEN_FREE
}

// Updated doc §12's "Additional dietary data" -> "Egg information" field.
enum EggInfo {
  NO_EGG
  CONTAINS_EGG
  EGG_OPTIONAL
}

model MenuItem {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  categoryId     String?
  category       MenuCategory? @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  name           String
  description    String?
  image          String?
  // Updated §12 "food-product toggle" — distinguishes food items from
  // non-food add-ons (e.g. a table decoration or a disposable-cutlery line).
  isFoodProduct  Boolean       @default(true)
  // Dietary fields only meaningful when isFoodProduct is true.
  foodType       FoodType?
  dietaryType    DietaryType?
  eggInfo        EggInfo?
  price          Decimal       @db.Decimal(10, 2)
  isActive       Boolean       @default(true)

  // Chunk 18 (Phase 2) attaches Recipe/BOM via this FK — left nullable now
  // per the roadmap's explicit note, so Phase 2 doesn't need a migration to
  // add it, without pulling Recipe/BOM logic itself forward.
  recipeId String?

  menus        MenuMenuItem[]
  packageItems MenuPackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([categoryId])
  @@map("menu_item")
}

model Menu {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  isActive       Boolean      @default(true)

  items MenuMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu")
}

// Menu <-> MenuItem membership (many-to-many: a catalog item can be reused
// across multiple named Menus, per Updated §12's reuse note). sortOrder
// controls display order within that Menu (e.g. on the Chunk 8 storefront).
model MenuMenuItem {
  id         String   @id @default(cuid())
  menuId     String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([menuId, menuItemId])
  @@index([menuId])
  @@index([menuItemId])
  @@map("menu_menu_item")
}

enum PackagePricingModel {
  FIXED
  PER_PERSON
}

model MenuPackage {
  id             String              @id @default(cuid())
  organizationId String
  organization   Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  pricingModel   PackagePricingModel
  // Exactly one of these two is set, matching pricingModel — enforced in
  // the module layer, not the schema (Postgres has no portable "exactly one
  // of" CHECK short of a trigger, and this mirrors how nullable pairs are
  // handled elsewhere in this schema, e.g. Subscription.endDate).
  fixedPrice     Decimal?            @db.Decimal(10, 2)
  perPersonPrice Decimal?            @db.Decimal(10, 2)
  minGuests      Int?
  maxGuests      Int?
  isActive       Boolean             @default(true)

  items MenuPackageItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu_package")
}

// A package's line items. isOptional = guest can choose to include/exclude;
// isAddOn = not part of the base package at all, offered as an extra. Both
// can carry extraPrice — added on top of the package's base price when
// selected (per-guest when the package is PER_PERSON, flat otherwise; see
// `calculatePackagePrice` in src/modules/menus/pricing.ts).
model MenuPackageItem {
  id         String      @id @default(cuid())
  packageId  String
  package    MenuPackage @relation(fields: [packageId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem    @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  isOptional Boolean     @default(false)
  isAddOn    Boolean     @default(false)
  extraPrice Decimal?    @db.Decimal(10, 2)
  createdAt  DateTime    @default(now())

  @@unique([packageId, menuItemId])
  @@index([packageId])
  @@index([menuItemId])
  @@map("menu_package_item")
}
