// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  isSuperAdmin Boolean @default(false)

  notificationsReceived Notification[]
  auditLogsActedOn      AuditLog[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  branches    Branch[]
  kitchens    Kitchen[]
  stores      Store[]

  notifications      Notification[]
  whatsAppMessages   WhatsAppMessage[]
  auditLogs          AuditLog[]
  secureAccessTokens SecureAccessToken[]
  settings           TenantSetting[]

  @@unique([slug])
  @@map("organization")
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- App-level models (not owned by Better Auth) ---
// Branch/Kitchen/Store hierarchy, PRD §47: Tenant(Organization) -> Branch ->
// Kitchen/Store -> Users/Inventory/Events. Schema now, multi-location UI
// later (Chunk 23) — every table below still carries `organizationId`
// directly (not just via Branch) so tenant-isolation queries never need a
// join to be enforced (PRD §54-55).

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  kitchens Kitchen[]
  stores   Store[]

  @@index([organizationId])
  @@map("branch")
}

model Kitchen {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("kitchen")
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("store")
}

// --- Chunk 2: Cross-Cutting Platform Service Interfaces ---
// Interfaces many later, unrelated chunks call — "interface now, integration
// later" (same pattern as auth's pluggable strategy from Chunk 1). Real
// WhatsApp/ZeptoMail/Push/SMS providers land in Chunk 16; these models exist
// so every module from Chunk 9 onward has something to call today.

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
  PUSH
  SMS
}

model Notification {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  event           String
  // Recipients are frequently customers (no `User` row exists for them until
  // Chunk 9's Customer model, and even then Customer isn't a User) — kept as
  // plain fields rather than a hard FK so this interface doesn't have to
  // change shape once Customer exists.
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  payload         Json
  createdAt       DateTime            @default(now())

  logs             NotificationLog[]
  whatsAppMessages WhatsAppMessage[]

  @@index([organizationId])
  @@map("notification")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@map("notification_log")
}

model WhatsAppMessage {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId    String?
  notification      Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  toPhone           String
  body              String
  providerMessageId String?
  status            String        @default("queued")
  createdAt         DateTime      @default(now())

  @@index([organizationId])
  @@map("whatsapp_message")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Audit trail must survive the actor being removed later — SetNull, not
  // Cascade, and the field stays optional.
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  recordType     String
  recordId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([recordType, recordId])
  @@map("audit_log")
}

enum SecureAccessResourceType {
  QUOTATION
  MENU_SELECTION
  INVOICE
  PAYMENT_LINK
}

model SecureAccessToken {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   SecureAccessResourceType
  resourceId     String
  token          String                   @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("secure_access_token")
}

model TenantSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("tenant_setting")
}
