// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  isSuperAdmin Boolean @default(false)

  // First/Last name are the real source of truth for a person's name
  // throughout the app; `name` stays required (Better Auth's own core
  // field) and is composed as `${firstName} ${lastName}`.trim() at every
  // write site — see src/lib/auth/auth.ts's `additionalFields`.
  firstName String?
  lastName  String?

  notificationsReceived Notification[]
  auditLogsActedOn      AuditLog[]
  inventoryTransactionsActedOn InventoryTransaction[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  branches    Branch[]
  kitchens    Kitchen[]
  stores      Store[]

  notifications      Notification[]
  whatsAppMessages   WhatsAppMessage[]
  auditLogs          AuditLog[]
  secureAccessTokens SecureAccessToken[]
  settings           TenantSetting[]

  // --- Chunk 3 Group 3.2: Super Admin tenant management (PRD §8) ---
  status          TenantStatus @default(ACTIVE)
  ownerFirstName  String?
  ownerLastName   String?
  contactPhone    String?
  contactEmail    String?
  gstNumber       String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  // Chunk 8's self-service limit is 2 free changes to `slug`; a Super Admin
  // can force further changes once this is exhausted (Group 3.2). The slug
  // column doubles as both the Better-Auth org slug and the public
  // storefront slug — there is only one.
  slugChangeCount Int          @default(0)

  // --- Chunk 4 Group 4.2: Self-serve onboarding business profile ---
  // Extends the same Organization row Chunk 3 already put address/GST/
  // contact fields on, rather than a separate BusinessProfile table —
  // avoids two places storing overlapping tenant profile data.
  businessDescription String?
  websiteUrl          String?
  instagramUrl        String?
  facebookUrl         String?
  gstShowOnInvoices   Boolean? @default(false)

  // Set only when the onboarding wizard's final "Complete Setup" step
  // succeeds — never by Skip, and never by a later Settings save. Drives
  // the Dashboard's "finish your profile" nudge banner.
  onboardingCompletedAt DateTime?

  subscriptions Subscription[]

  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  menus          Menu[]
  eventTypes     EventType[]
  addOns         AddOn[]
  inventoryItems Inventory[]

  @@unique([slug])
  @@map("organization")
}

// Chunk 3 Group 3.2 — Suspend/Activate/Deactivate are three distinct admin
// actions (PRD §8.2), not two independent booleans. No hard-delete path: an
// Organization's FKs cascade into its own AuditLog, so a literal delete
// would destroy the record of the very action deleting it.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // Chunk 5 Group 5.2 — reversible "disable a teammate" state. Better Auth's
  // own API only offers a hard-delete `removeMember`; this is the softer
  // state that requireActiveOrganization()/requireOrg() enforce, locking a
  // disabled member out of every caterer-facing route without removing them.
  disabledAt DateTime?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- App-level models (not owned by Better Auth) ---
// Branch/Kitchen/Store hierarchy, PRD §47: Tenant(Organization) -> Branch ->
// Kitchen/Store -> Users/Inventory/Events. Schema now, multi-location UI
// later (Chunk 23) — every table below still carries `organizationId`
// directly (not just via Branch) so tenant-isolation queries never need a
// join to be enforced (PRD §54-55).

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  kitchens Kitchen[]
  stores   Store[]

  @@index([organizationId])
  @@map("branch")
}

model Kitchen {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("kitchen")
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("store")
}

// --- Chunk 2: Cross-Cutting Platform Service Interfaces ---
// Interfaces many later, unrelated chunks call — "interface now, integration
// later" (same pattern as auth's pluggable strategy from Chunk 1). Real
// WhatsApp/ZeptoMail/Push/SMS providers land in Chunk 16; these models exist
// so every module from Chunk 9 onward has something to call today.

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
  PUSH
  SMS
}

model Notification {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  event           String
  // Recipients are frequently customers (no `User` row exists for them until
  // Chunk 9's Customer model, and even then Customer isn't a User) — kept as
  // plain fields rather than a hard FK so this interface doesn't have to
  // change shape once Customer exists.
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  payload         Json
  createdAt       DateTime            @default(now())

  logs             NotificationLog[]
  whatsAppMessages WhatsAppMessage[]

  @@index([organizationId])
  @@map("notification")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@map("notification_log")
}

model WhatsAppMessage {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId    String?
  notification      Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  toPhone           String
  body              String
  providerMessageId String?
  status            String        @default("queued")
  createdAt         DateTime      @default(now())

  @@index([organizationId])
  @@map("whatsapp_message")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Audit trail must survive the actor being removed later — SetNull, not
  // Cascade, and the field stays optional.
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  recordType     String
  recordId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([recordType, recordId])
  @@map("audit_log")
}

enum SecureAccessResourceType {
  QUOTATION
  MENU_SELECTION
  INVOICE
  PAYMENT_LINK
}

model SecureAccessToken {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   SecureAccessResourceType
  resourceId     String
  token          String                   @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("secure_access_token")
}

model TenantSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("tenant_setting")
}

// --- Chunk 3 Group 3.3: Subscription Plans (PRD §9, §58) ---
// Definitions only — no live Razorpay billing yet (Chunk 20 reuses Chunk
// 14's integration). `SubscriptionPlan` is a platform-wide catalog (like
// `User`), not tenant-owned data, so it's deliberately exempt from the
// "every app-level model carries organizationId" convention used elsewhere.

model SubscriptionPlan {
  id                String   @id @default(cuid())
  // Stable machine key (e.g. "trial") that Chunk 4's onboarding wizard looks
  // up directly, independent of the human-editable `name`.
  code              String   @unique
  name              String
  description       String?
  isTrial           Boolean  @default(false)
  // Only meaningful when isTrial — the seeded Trial plan uses 7.
  trialDurationDays Int?
  priceMonthly      Decimal? @db.Decimal(10, 2)
  priceAnnual       Decimal? @db.Decimal(10, 2)
  currency          String   @default("INR")

  // PRD §9 limits list. Null means unlimited.
  maxUsers            Int?
  maxEvents           Int?
  maxOrders           Int?
  maxKitchens         Int?
  maxStores           Int?
  maxCustomers        Int?
  maxMenuLinks        Int?
  maxStorageMb        Int?
  maxReports          Int?
  maxWhatsappMessages Int?

  // Retire a plan without breaking Subscription history's FK — never
  // hard-delete (Restrict below would block it anyway once assigned).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  startDate          DateTime           @default(now())
  trialEndsAt        DateTime?
  // Set when superseded/cancelled; null while this is the tenant's current
  // subscription. History is kept, never deleted (immutable per the updated
  // product doc's accounting/audit note, §19).
  endDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("subscription")
}

// --- Chunk 6: Menu & Product Catalog (PRD §22-24, Updated doc §12) ---
// Reworked 2026-09-14 per AJ's explicit field-level spec, replacing the
// original MenuPackage-based model entirely (no production tenant data
// existed, so this is a clean schema swap, not a migration). Menu is now
// the top-level, priced, sellable object; MenuCategory is a reusable entity
// assigned to Menu(s) via MenuCategoryAssignment, which carries a
// per-(category,menu) max-selection and display order — the same category
// (e.g. "Starters") can allow choosing 2 items on one menu and 3 on
// another, since those are different Menu rows. MenuItem's category tags
// (MenuItemCategory) and its menu assignments (MenuMenuItem) are
// deliberately independent of each other (AJ confirmed), not derived.

model MenuCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  itemAssignments MenuItemCategory[]
  menuAssignments MenuCategoryAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_category")
}

// Reused for both Menu.menuType and MenuItem.foodType — AJ's "Menu Type,
// for ex-veg" field on each.
enum FoodType {
  VEGETARIAN
  NON_VEGETARIAN
}

model MenuItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  foodType       FoodType
  price          Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)

  // Chunk 18 (Phase 2) attaches Recipe/BOM via this FK — left nullable now
  // per the roadmap's explicit note, so Phase 2 doesn't need a migration to
  // add it, without pulling Recipe/BOM logic itself forward.
  recipeId String?

  categories MenuItemCategory[]
  menus      MenuMenuItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu_item")
}

// MenuItem <-> MenuCategory tagging (many-to-many) — independent of which
// Menus the item is assigned to below; a caterer sets both separately.
model MenuItemCategory {
  id         String       @id @default(cuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([menuItemId, categoryId])
  @@index([menuItemId])
  @@index([categoryId])
  @@map("menu_item_category")
}

model Menu {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  menuType       FoodType
  pricePerPlate  Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)

  items               MenuMenuItem[]
  categoryAssignments MenuCategoryAssignment[]
  eventTypes          EventTypeMenu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu")
}

// Menu <-> MenuItem membership (many-to-many, direct — independent of
// category assignment, per AJ's "Assign to Menus" field on MenuItem).
// sortOrder controls display order within that Menu.
model MenuMenuItem {
  id         String   @id @default(cuid())
  menuId     String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([menuId, menuItemId])
  @@index([menuId])
  @@index([menuItemId])
  @@map("menu_menu_item")
}

// MenuCategory <-> Menu assignment — the same category can be linked to
// multiple menus with a different maxSelection/sortOrder on each (AJ's
// example: "Starters" allows choosing 2 items on a Veg menu, 3 on a
// Non-Veg menu — two different Menu rows, two different assignment rows).
// maxSelection null = unlimited.
model MenuCategoryAssignment {
  id           String       @id @default(cuid())
  menuId       String
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  maxSelection Int?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@unique([menuId, categoryId])
  @@index([menuId])
  @@index([categoryId])
  @@map("menu_category_assignment")
}

// --- Event Types (pulled forward from dev plans/chunk-09-crm-core.md §9.1,
// scoped down to just what AJ asked for here) ---
// A caterer's catalog of the *types* of events they cater (e.g. "Wedding
// Event"), each offering a set of eligible Menus. Deliberately named
// EventType, not Event, even though every user-facing string says "Event"
// — chunk-09-crm-core.md §9.4 reserves the bare name `Event` for a much
// bigger future transactional model (Customer, dates, kitchen, inventory);
// reusing that name now would force a rename migration later. isActive
// wasn't in AJ's field list but is added for consistency with every other
// catalog entity's soft-delete convention here.
model EventType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  minGuests      Int?
  isActive       Boolean      @default(true)

  menus EventTypeMenu[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("event_type")
}

model EventTypeMenu {
  id          String    @id @default(cuid())
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  menuId      String
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([eventTypeId, menuId])
  @@index([eventTypeId])
  @@index([menuId])
  @@map("event_type_menu")
}

// Add-ons Management (2026-09-14, AJ's own field-level spec): Live Counters
// and Special Add-ons in one shared catalog, distinguished by `type`.
// Deliberately standalone — not assigned to Menus or EventTypes — AJ:
// "these will be Standalone and will be showcased after menu selections,"
// which describes a future order-flow behavior (Chunk 10/11), not anything
// built here. isActive wasn't in AJ's field list but is added for
// consistency with every other catalog entity's soft-delete convention.
enum AddOnType {
  LIVE_COUNTER
  SPECIAL_ADD_ON
}

enum AddOnPriceType {
  PER_PLATE
  FIXED
}

model AddOn {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  type           AddOnType
  priceType      AddOnPriceType
  price          Decimal        @db.Decimal(10, 2)
  isActive       Boolean        @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("add_on")
}

// Chunk 7 (Inventory, Basic) — PRD §35 (subset), Updated doc §13's exact Add
// Inventory Item field list. Simple text-field supplier contact directly on
// the item (no `Ingredient`/full `Supplier` entity/FK yet — that's Chunk 18,
// see the chunk file's note); `storageLocation` stays a plain text field,
// not a `Store` FK, matching Updated doc §13 exactly (multi-location Store
// assignment is Chunk 23 UI on the schema Chunk 1 already stubbed).
enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model Inventory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  category       String
  description    String?
  image          String?
  unit           String
  // Current on-hand balance — the source of truth for "what do we have",
  // kept in sync with each InventoryTransaction inside one DB transaction
  // (src/modules/inventory/inventory.ts's `recordStockTransaction`) rather
  // than recomputed by summing the ledger on every read.
  stockCount        Decimal   @db.Decimal(12, 2) @default(0)
  lowStockThreshold Decimal?  @db.Decimal(12, 2)
  costPerUnit       Decimal?  @db.Decimal(10, 2)
  storageLocation   String?
  supplierName      String?
  supplierContact   String?
  expiryDate        DateTime?

  transactions InventoryTransaction[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("inventory")
}

// No `organizationId` of its own — cascades automatically (DB-level
// onDelete: Cascade) off its parent Inventory row, same pattern as
// MenuMenuItem/EventTypeMenu (see tenant-scoped-models.ts's comment).
model InventoryTransaction {
  id          String                   @id @default(cuid())
  inventoryId String
  inventory   Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryTransactionType
  // Always a positive magnitude for STOCK_IN/STOCK_OUT; a signed delta
  // (can be negative) for ADJUSTMENT — see `recordStockTransaction`'s
  // stock-quantity math for the exact rules each type applies.
  quantity Decimal @db.Decimal(12, 2)
  note     String?

  // Nullable/SetNull so the ledger entry survives actor deletion, same
  // rationale as AuditLog.actorUserId.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@map("inventory_transaction")
}
