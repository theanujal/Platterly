// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String       @id
  name          String
  email         String
  emailVerified Boolean      @default(false)
  image         String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  sessions      Session[]
  accounts      Account[]
  members       Member[]
  invitations   Invitation[]

  isSuperAdmin Boolean @default(false)

  // First/Last name are the real source of truth for a person's name
  // throughout the app; `name` stays required (Better Auth's own core
  // field) and is composed as `${firstName} ${lastName}`.trim() at every
  // write site — see src/lib/auth/auth.ts's `additionalFields`.
  firstName String?
  lastName  String?

  // Collected at signup via the shared `PhoneInput` (AJ, 2026-09-19) — see
  // `additionalFields.phone` in src/lib/auth/auth.ts.
  phone String?

  notificationsReceived        Notification[]
  auditLogsActedOn             AuditLog[]
  inventoryTransactionsActedOn InventoryTransaction[]

  @@unique([email])
  @@map("user")
}

model Session {
  id                   String   @id
  expiresAt            DateTime
  token                String
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  ipAddress            String?
  userAgent            String?
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  activeOrganizationId String?

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

model Organization {
  id          String       @id
  name        String
  slug        String
  logo        String?
  createdAt   DateTime
  metadata    String?
  members     Member[]
  invitations Invitation[]
  branches    Branch[]
  kitchens    Kitchen[]
  stores      Store[]

  notifications      Notification[]
  whatsAppMessages   WhatsAppMessage[]
  auditLogs          AuditLog[]
  secureAccessTokens SecureAccessToken[]
  settings           TenantSetting[]

  // --- Chunk 3 Group 3.2: Super Admin tenant management (PRD §8) ---
  status          TenantStatus @default(ACTIVE)
  ownerFirstName  String?
  ownerLastName   String?
  contactPhone    String?
  contactEmail    String?
  gstNumber       String?
  addressLine1    String?
  addressLine2    String?
  city            String?
  state           String?
  postalCode      String?
  country         String?
  // Chunk 8's self-service limit is 2 free changes to `slug`; a Super Admin
  // can force further changes once this is exhausted (Group 3.2). The slug
  // column doubles as both the Better-Auth org slug and the public
  // storefront slug — there is only one.
  slugChangeCount Int          @default(0)

  // --- Chunk 4 Group 4.2: Self-serve onboarding business profile ---
  // Extends the same Organization row Chunk 3 already put address/GST/
  // contact fields on, rather than a separate BusinessProfile table —
  // avoids two places storing overlapping tenant profile data.
  businessDescription String?
  websiteUrl          String?
  instagramUrl        String?
  facebookUrl         String?
  gstShowOnInvoices   Boolean? @default(false)

  // Set only when the onboarding wizard's final "Complete Setup" step
  // succeeds — never by Skip, and never by a later Settings save. Drives
  // the Dashboard's "finish your profile" nudge banner.
  onboardingCompletedAt DateTime?

  // --- Order Numbering — Kitchen Admin-configurable prefix/counter for
  // human-readable Order Numbers (e.g. "AJ-0001"). Assigned once per Order
  // at creation (src/modules/orders/order.ts's nextOrderNumber), never
  // recalculated later — orderNumberNextValue is the atomic counter.
  orderNumberPrefix    String @default("ORD")
  orderNumberNextValue Int    @default(1)
  orderNumberPadding   Int    @default(4)

  subscriptions Subscription[]

  menuCategories MenuCategory[]
  menuItems      MenuItem[]
  menus          Menu[]
  eventTypes     EventType[]
  addOns         AddOn[]
  inventoryItems Inventory[]
  customers      Customer[]
  events         Event[]
  orders         Order[]
  quotations     Quotation[]
  menuSelections MenuSelection[]

  @@unique([slug])
  @@map("organization")
}

// Chunk 3 Group 3.2 — Suspend/Activate/Deactivate are three distinct admin
// actions (PRD §8.2), not two independent booleans. No hard-delete path: an
// Organization's FKs cascade into its own AuditLog, so a literal delete
// would destroy the record of the very action deleting it.
enum TenantStatus {
  ACTIVE
  SUSPENDED
  DEACTIVATED
}

model Member {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           String       @default("member")
  createdAt      DateTime

  // Chunk 5 Group 5.2 — reversible "disable a teammate" state. Better Auth's
  // own API only offers a hard-delete `removeMember`; this is the softer
  // state that requireActiveOrganization()/requireOrg() enforce, locking a
  // disabled member out of every caterer-facing route without removing them.
  disabledAt DateTime?

  @@index([organizationId])
  @@index([userId])
  @@map("member")
}

model Invitation {
  id             String       @id
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  email          String
  role           String?
  status         String       @default("pending")
  expiresAt      DateTime
  createdAt      DateTime     @default(now())
  inviterId      String
  user           User         @relation(fields: [inviterId], references: [id], onDelete: Cascade)

  @@index([organizationId])
  @@index([email])
  @@map("invitation")
}

// --- App-level models (not owned by Better Auth) ---
// Branch/Kitchen/Store hierarchy, PRD §47: Tenant(Organization) -> Branch ->
// Kitchen/Store -> Users/Inventory/Events. Schema now, multi-location UI
// later (Chunk 23) — every table below still carries `organizationId`
// directly (not just via Branch) so tenant-isolation queries never need a
// join to be enforced (PRD §54-55).

model Branch {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  kitchens Kitchen[]
  stores   Store[]

  @@index([organizationId])
  @@map("branch")
}

model Kitchen {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  events Event[]

  @@index([organizationId])
  @@index([branchId])
  @@map("kitchen")
}

model Store {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  branchId       String
  branch         Branch       @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name           String
  isDefault      Boolean      @default(false)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([organizationId])
  @@index([branchId])
  @@map("store")
}

// --- Chunk 2: Cross-Cutting Platform Service Interfaces ---
// Interfaces many later, unrelated chunks call — "interface now, integration
// later" (same pattern as auth's pluggable strategy from Chunk 1). Real
// WhatsApp/ZeptoMail/Push/SMS providers land in Chunk 16; these models exist
// so every module from Chunk 9 onward has something to call today.

enum NotificationChannel {
  WHATSAPP
  EMAIL
  IN_APP
  PUSH
  SMS
}

model Notification {
  id              String              @id @default(cuid())
  organizationId  String
  organization    Organization        @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  channel         NotificationChannel
  event           String
  // Recipients are frequently customers (no `User` row exists for them until
  // Chunk 9's Customer model, and even then Customer isn't a User) — kept as
  // plain fields rather than a hard FK so this interface doesn't have to
  // change shape once Customer exists.
  recipientEmail  String?
  recipientPhone  String?
  recipientUserId String?
  recipientUser   User?               @relation(fields: [recipientUserId], references: [id], onDelete: SetNull)
  payload         Json
  createdAt       DateTime            @default(now())

  logs             NotificationLog[]
  whatsAppMessages WhatsAppMessage[]

  @@index([organizationId])
  @@map("notification")
}

model NotificationLog {
  id             String       @id @default(cuid())
  notificationId String
  notification   Notification @relation(fields: [notificationId], references: [id], onDelete: Cascade)
  status         String
  detail         String?
  createdAt      DateTime     @default(now())

  @@index([notificationId])
  @@map("notification_log")
}

model WhatsAppMessage {
  id                String        @id @default(cuid())
  organizationId    String
  organization      Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  notificationId    String?
  notification      Notification? @relation(fields: [notificationId], references: [id], onDelete: SetNull)
  toPhone           String
  body              String
  providerMessageId String?
  status            String        @default("queued")
  createdAt         DateTime      @default(now())

  @@index([organizationId])
  @@map("whatsapp_message")
}

model AuditLog {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  // Audit trail must survive the actor being removed later — SetNull, not
  // Cascade, and the field stays optional.
  actorUserId    String?
  actorUser      User?        @relation(fields: [actorUserId], references: [id], onDelete: SetNull)
  action         String
  recordType     String
  recordId       String
  before         Json?
  after          Json?
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([recordType, recordId])
  @@map("audit_log")
}

// MENU_SELECTION removed 2026-09-17 — Chunk 11 doesn't use this token
// service (see src/lib/secure-access/token.ts's header comment).
enum SecureAccessResourceType {
  QUOTATION
  INVOICE
  PAYMENT_LINK
}

model SecureAccessToken {
  id             String                   @id @default(cuid())
  organizationId String
  organization   Organization             @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  resourceType   SecureAccessResourceType
  resourceId     String
  token          String                   @unique
  expiresAt      DateTime?
  revokedAt      DateTime?
  createdAt      DateTime                 @default(now())

  @@index([organizationId])
  @@index([resourceType, resourceId])
  @@map("secure_access_token")
}

model TenantSetting {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  key            String
  value          Json
  updatedAt      DateTime     @updatedAt

  @@unique([organizationId, key])
  @@map("tenant_setting")
}

// --- Chunk 3 Group 3.3: Subscription Plans (PRD §9, §58) ---
// Definitions only — no live Razorpay billing yet (Chunk 20 reuses Chunk
// 14's integration). `SubscriptionPlan` is a platform-wide catalog (like
// `User`), not tenant-owned data, so it's deliberately exempt from the
// "every app-level model carries organizationId" convention used elsewhere.

model SubscriptionPlan {
  id                String   @id @default(cuid())
  // Stable machine key (e.g. "trial") that Chunk 4's onboarding wizard looks
  // up directly, independent of the human-editable `name`.
  code              String   @unique
  name              String
  description       String?
  isTrial           Boolean  @default(false)
  // Only meaningful when isTrial — the seeded Trial plan uses 7.
  trialDurationDays Int?
  priceMonthly      Decimal? @db.Decimal(10, 2)
  priceAnnual       Decimal? @db.Decimal(10, 2)
  currency          String   @default("INR")

  // PRD §9 limits list. Null means unlimited.
  maxUsers            Int?
  maxEvents           Int?
  maxOrders           Int?
  maxKitchens         Int?
  maxStores           Int?
  maxCustomers        Int?
  maxMenuLinks        Int?
  maxStorageMb        Int?
  maxReports          Int?
  maxWhatsappMessages Int?

  // Retire a plan without breaking Subscription history's FK — never
  // hard-delete (Restrict below would block it anyway once assigned).
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  subscriptions Subscription[]

  @@map("subscription_plan")
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  EXPIRED
  CANCELLED
}

model Subscription {
  id                 String             @id @default(cuid())
  organizationId     String
  organization       Organization       @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  subscriptionPlanId String
  subscriptionPlan   SubscriptionPlan   @relation(fields: [subscriptionPlanId], references: [id], onDelete: Restrict)
  status             SubscriptionStatus
  startDate          DateTime           @default(now())
  trialEndsAt        DateTime?
  // Set when superseded/cancelled; null while this is the tenant's current
  // subscription. History is kept, never deleted (immutable per the updated
  // product doc's accounting/audit note, §19).
  endDate            DateTime?
  createdAt          DateTime           @default(now())
  updatedAt          DateTime           @updatedAt

  @@index([organizationId])
  @@index([organizationId, status])
  @@map("subscription")
}

// --- Chunk 6: Menu & Product Catalog (PRD §22-24, Updated doc §12) ---
// Reworked 2026-09-14 per AJ's explicit field-level spec, replacing the
// original MenuPackage-based model entirely (no production tenant data
// existed, so this is a clean schema swap, not a migration). Menu is now
// the top-level, priced, sellable object; MenuCategory is a reusable entity
// assigned to Menu(s) via MenuCategoryAssignment, which carries a
// per-(category,menu) max-selection and display order — the same category
// (e.g. "Starters") can allow choosing 2 items on one menu and 3 on
// another, since those are different Menu rows. MenuItem's category tags
// (MenuItemCategory) and its menu assignments (MenuMenuItem) are
// deliberately independent of each other (AJ confirmed), not derived.

model MenuCategory {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  isActive       Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  itemAssignments MenuItemCategory[]
  menuAssignments MenuCategoryAssignment[]

  @@unique([organizationId, name])
  @@index([organizationId])
  @@map("menu_category")
}

// Reused for both Menu.menuType and MenuItem.foodType — AJ's "Menu Type,
// for ex-veg" field on each.
enum FoodType {
  VEGETARIAN
  NON_VEGETARIAN
}

// Food Item Additional Details (2026-09-17, AJ) — curated single-select
// vocabularies for the Indian-catering domain, each with an OTHER escape
// hatch where the value space is genuinely open-ended. All optional on
// MenuItem; nothing here is required or defaulted.
enum MenuItemOrigin {
  NORTH_INDIAN
  SOUTH_INDIAN
  PUNJABI
  GUJARATI
  BENGALI
  MUGHLAI
  CHINESE
  CONTINENTAL
  ITALIAN
  MEXICAN
  THAI
  SOUTH_EAST_ASIAN
  FUSION
  OTHER
}

enum MenuItemBaseType {
  GRAVY_BASED
  DRY
  CREAM_BASED
  TOMATO_BASED
  COCONUT_BASED
  YOGURT_BASED
  CLEAR
  OTHER
}

enum MenuItemPreparationMethod {
  GRILLED
  ROASTED
  DEEP_FRIED
  SHALLOW_FRIED
  STEAMED
  SAUTEED
  BAKED
  BOILED
  TANDOOR
  RAW
  SLOW_COOKED
  OTHER
}

enum MenuItemSpiceLevel {
  NONE
  MILD
  MEDIUM
  SPICY
  EXTRA_SPICY
}

// Jain-friendly indicator — a common Indian-catering requirement.
enum MenuItemOnionGarlic {
  WITH_ONION_GARLIC
  WITHOUT_ONION_GARLIC
}

enum MenuItemTexture {
  CRISPY
  SOFT
  CREAMY
  CRUNCHY
  SMOOTH
  CHEWY
  JUICY
  FLAKY
  OTHER
}

enum MenuItemTasteProfile {
  SWEET
  SOUR
  SPICY
  TANGY
  SAVORY
  BITTER
  UMAMI
  MILD
}

model MenuItem {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  foodType       FoodType
  price          Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)

  // Additional Details (2026-09-17, AJ) — all optional, edited from the
  // same Food Item form as Basic Information, dynamically consumed by the
  // (not-yet-built) customer-facing menu: a field left unset here simply
  // doesn't render there, no placeholder/default text. `vegFriendly`/
  // `nonVegFriendly` are deliberately independent nullable booleans, not a
  // single enum — distinct from the existing strict `foodType` above,
  // this instead flags whether the dish can additionally suit a veg or
  // non-veg guest (e.g. a base gravy offered either way), so both, one, or
  // neither can be set without forcing a single classification.
  origin            MenuItemOrigin?
  baseType          MenuItemBaseType?
  preparationMethod MenuItemPreparationMethod?
  spiceLevel        MenuItemSpiceLevel?
  onionGarlic       MenuItemOnionGarlic?
  vegFriendly       Boolean?
  nonVegFriendly    Boolean?
  texture           MenuItemTexture?
  tasteProfile      MenuItemTasteProfile?
  // Free text — ingredient names have no fixed vocabulary, unlike the
  // curated fields above. Comma-separated, parsed at the form boundary.
  keyIngredients    String?

  // Chunk 18 (Phase 2) attaches Recipe/BOM via this FK — left nullable now
  // per the roadmap's explicit note, so Phase 2 doesn't need a migration to
  // add it, without pulling Recipe/BOM logic itself forward.
  recipeId String?

  categories         MenuItemCategory[]
  menus              MenuMenuItem[]
  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  menuSelectionItems MenuSelectionItem[]
  menuVersionItems   MenuVersionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu_item")
}

// MenuItem <-> MenuCategory tagging (many-to-many) — independent of which
// Menus the item is assigned to below; a caterer sets both separately.
model MenuItemCategory {
  id         String       @id @default(cuid())
  menuItemId String
  menuItem   MenuItem     @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  categoryId String
  category   MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  createdAt  DateTime     @default(now())

  @@unique([menuItemId, categoryId])
  @@index([menuItemId])
  @@index([categoryId])
  @@map("menu_item_category")
}

model Menu {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  menuType       FoodType
  pricePerPlate  Decimal      @db.Decimal(10, 2)
  isActive       Boolean      @default(true)

  // Children Guests & Pricing — under-5 is complimentary unless explicitly
  // opted into being charged; 5-10 always prices, either as a percentage of
  // this Menu's own pricePerPlate or a flat per-plate amount (chosen via
  // child5To10PricingType), same reused-field-with-a-type-toggle shape as
  // AddOn.priceType/price.
  childUnder5Chargeable Boolean          @default(false)
  childUnder5Price      Decimal?         @db.Decimal(10, 2)
  child5To10PricingType ChildPricingType @default(FIXED)
  child5To10PriceValue  Decimal?         @db.Decimal(10, 2)

  items               MenuMenuItem[]
  categoryAssignments MenuCategoryAssignment[]
  eventTypes          EventTypeMenu[]
  orderItems          OrderItem[]
  quotationItems      QuotationItem[]
  mealPlanEntries     MealPlanEntry[]
  childPricingOrders  Order[]
  menuSelectionItems  MenuSelectionItem[]
  menuVersionItems    MenuVersionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu")
}

// Menu <-> MenuItem membership (many-to-many, direct — independent of
// category assignment, per AJ's "Assign to Menus" field on MenuItem).
// sortOrder controls display order within that Menu.
model MenuMenuItem {
  id         String   @id @default(cuid())
  menuId     String
  menu       Menu     @relation(fields: [menuId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  sortOrder  Int      @default(0)
  createdAt  DateTime @default(now())

  @@unique([menuId, menuItemId])
  @@index([menuId])
  @@index([menuItemId])
  @@map("menu_menu_item")
}

// MenuCategory <-> Menu assignment — the same category can be linked to
// multiple menus with a different maxSelection/sortOrder on each (AJ's
// example: "Starters" allows choosing 2 items on a Veg menu, 3 on a
// Non-Veg menu — two different Menu rows, two different assignment rows).
// maxSelection null = unlimited.
model MenuCategoryAssignment {
  id           String       @id @default(cuid())
  menuId       String
  menu         Menu         @relation(fields: [menuId], references: [id], onDelete: Cascade)
  categoryId   String
  category     MenuCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  maxSelection Int?
  sortOrder    Int          @default(0)
  createdAt    DateTime     @default(now())

  @@unique([menuId, categoryId])
  @@index([menuId])
  @@index([categoryId])
  @@map("menu_category_assignment")
}

// --- Event Types (pulled forward from dev plans/chunk-09-crm-core.md §9.1,
// scoped down to just what AJ asked for here) ---
// A caterer's catalog of the *types* of events they cater (e.g. "Wedding
// Event"), each offering a set of eligible Menus. Deliberately named
// EventType, not Event, even though every user-facing string says "Event"
// — chunk-09-crm-core.md §9.4 reserves the bare name `Event` for a much
// bigger future transactional model (Customer, dates, kitchen, inventory);
// reusing that name now would force a rename migration later. isActive
// wasn't in AJ's field list but is added for consistency with every other
// catalog entity's soft-delete convention here.
model EventType {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  minGuests      Int?
  isActive       Boolean      @default(true)
  // Chunk 9 Group 9.1 — a curated icon-name key (see
  // src/lib/event-type-icons.ts), not a free-form upload; Updated doc §7's
  // "Icon"/"Sort order" fields, added on top of the Chunk 6-era scoped-down
  // build. "Default menu/package/pricing rules" (also named in §7) stays
  // deliberately unbuilt — nothing downstream consumes it yet (Quotation/
  // Order is Chunk 10); documented as a deferral, not a silent omission.
  icon           String?
  sortOrder      Int          @default(0)

  menus      EventTypeMenu[]
  events     Event[]
  orders     Order[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("event_type")
}

model EventTypeMenu {
  id          String    @id @default(cuid())
  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Cascade)
  menuId      String
  menu        Menu      @relation(fields: [menuId], references: [id], onDelete: Cascade)
  createdAt   DateTime  @default(now())

  @@unique([eventTypeId, menuId])
  @@index([eventTypeId])
  @@index([menuId])
  @@map("event_type_menu")
}

// Add-ons Management (2026-09-14, AJ's own field-level spec): Live Counters
// and Special Add-ons in one shared catalog, distinguished by `type`.
// Deliberately standalone — not assigned to Menus or EventTypes — AJ:
// "these will be Standalone and will be showcased after menu selections,"
// which describes a future order-flow behavior (Chunk 10/11), not anything
// built here. isActive wasn't in AJ's field list but is added for
// consistency with every other catalog entity's soft-delete convention.
enum AddOnType {
  LIVE_COUNTER
  SPECIAL_ADD_ON
}

enum AddOnPriceType {
  PER_PLATE
  FIXED
}

enum ChildPricingType {
  PERCENTAGE
  FIXED
}

model AddOn {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  description    String?
  image          String?
  type           AddOnType
  priceType      AddOnPriceType
  price          Decimal        @db.Decimal(10, 2)
  isActive       Boolean        @default(true)

  orderItems         OrderItem[]
  quotationItems     QuotationItem[]
  menuSelectionItems MenuSelectionItem[]
  menuVersionItems   MenuVersionItem[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("add_on")
}

// Chunk 7 (Inventory, Basic) — PRD §35 (subset), Updated doc §13's exact Add
// Inventory Item field list. Simple text-field supplier contact directly on
// the item (no `Ingredient`/full `Supplier` entity/FK yet — that's Chunk 18,
// see the chunk file's note); `storageLocation` stays a plain text field,
// not a `Store` FK, matching Updated doc §13 exactly (multi-location Store
// assignment is Chunk 23 UI on the schema Chunk 1 already stubbed).
enum InventoryTransactionType {
  STOCK_IN
  STOCK_OUT
  ADJUSTMENT
}

model Inventory {
  id                String       @id @default(cuid())
  organizationId    String
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name              String
  category          String
  description       String?
  image             String?
  unit              String
  // Current on-hand balance — the source of truth for "what do we have",
  // kept in sync with each InventoryTransaction inside one DB transaction
  // (src/modules/inventory/inventory.ts's `recordStockTransaction`) rather
  // than recomputed by summing the ledger on every read.
  stockCount        Decimal      @default(0) @db.Decimal(12, 2)
  lowStockThreshold Decimal?     @db.Decimal(12, 2)
  costPerUnit       Decimal?     @db.Decimal(10, 2)
  storageLocation   String?
  supplierName      String?
  supplierContact   String?
  expiryDate        DateTime?

  transactions     InventoryTransaction[]
  requiredByEvents EventRequiredInventory[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("inventory")
}

// No `organizationId` of its own — cascades automatically (DB-level
// onDelete: Cascade) off its parent Inventory row, same pattern as
// MenuMenuItem/EventTypeMenu (see tenant-scoped-models.ts's comment).
model InventoryTransaction {
  id          String                   @id @default(cuid())
  inventoryId String
  inventory   Inventory                @relation(fields: [inventoryId], references: [id], onDelete: Cascade)
  type        InventoryTransactionType
  // Always a positive magnitude for STOCK_IN/STOCK_OUT; a signed delta
  // (can be negative) for ADJUSTMENT — see `recordStockTransaction`'s
  // stock-quantity math for the exact rules each type applies.
  quantity    Decimal                  @db.Decimal(12, 2)
  note        String?

  // Nullable/SetNull so the ledger entry survives actor deletion, same
  // rationale as AuditLog.actorUserId.
  actorUserId String?
  actor       User?   @relation(fields: [actorUserId], references: [id], onDelete: SetNull)

  createdAt DateTime @default(now())

  @@index([inventoryId])
  @@map("inventory_transaction")
}

// Chunk 9 — CRM Core: Customer, Event. Lead/Enquiry merged into Customer
// (2026-09-17, AJ) — one record per person, not two: `isEnquiry`/`leadSource`
// carry the lightweight lead-capture info directly on Customer instead of a
// separate Enquiry entity, and whether someone is a Lead or a Customer is
// derived from Order.customerId (see `getCustomerStatus`/`listCustomers` in
// customer.ts), not a synced column that could drift.
//
// Updated doc §11's "Add New Lead" source options.
enum EnquiryLeadSource {
  MANUAL_ENTRY
  REFERRAL
  WEBSITE
  SOCIAL_MEDIA
  ADVERTISEMENT
  COLD_CALL
  NETWORKING
  OTHER
}

model Customer {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  phone          String
  email          String?
  notes          String?
  isActive       Boolean      @default(true)

  // "Is this an enquiry?" toggle — when true, `leadSource`/`notes` above
  // hold the Lead Information captured at intake. Status (Lead vs Customer)
  // is derived from whether any Order references this Customer, not stored
  // here — see the module-level comment above.
  isEnquiry  Boolean            @default(false)
  leadSource EnquiryLeadSource?

  events     Event[]
  orders     Order[]
  quotations Quotation[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Added 2026-09-17 for Chunk 11's phone-based customer lookup
  // (findCustomerByPhone) — verified no existing duplicate
  // (organizationId, phone) pairs in dev data before adding.
  @@unique([organizationId, phone])
  @@index([organizationId])
  @@map("customer")
}

// Matches the Events Dashboard's own status filter values exactly (Updated
// doc §9: All Status/Pending/Processing/Completed/Cancelled).
enum EventStatus {
  PENDING
  PROCESSING
  COMPLETED
  CANCELLED
}

model Event {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  eventTypeId String
  eventType   EventType @relation(fields: [eventTypeId], references: [id], onDelete: Restrict)

  // Nullable — only one default Kitchen is usable until Chunk 23's
  // multi-location UI; SetNull rather than Restrict since a Kitchen going
  // away shouldn't block deleting/keeping the Event itself.
  assignedKitchenId String?
  assignedKitchen   Kitchen? @relation(fields: [assignedKitchenId], references: [id], onDelete: SetNull)

  name       String
  // Date range, not a single date (Updated doc's multi-day event support) —
  // Chunk 10's Meal Planning depends on this.
  startDate  DateTime
  endDate    DateTime
  venue      String?
  guestCount Int?
  notes      String?
  status     EventStatus @default(PENDING)

  // Populated once the caterer chooses "Yes, create event" after Order
  // creation (Updated doc §8, Chunk 10 Group 10.6). SetNull, not Restrict —
  // deleting an Order should never block deleting/keeping its Event, it
  // just unlinks it. Nullable/non-unique: an Event can exist with no Order
  // yet, and nothing stops several Events sharing one Order (e.g. a
  // multi-day booking with a distinct operational day each) — see the
  // Order/Event judgment call in dev plans/index.md #14.
  orderId String?
  order   Order?  @relation(fields: [orderId], references: [id], onDelete: SetNull)

  requiredInventory EventRequiredInventory[]
  // Chunk 11 — at most one MenuSelection per Event (MenuSelection.eventId
  // is @unique).
  menuSelection     MenuSelection?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@index([eventTypeId])
  @@map("event")
}

// No `organizationId` of its own — cascades automatically off its parent
// Event row, same pattern as MenuMenuItem/EventTypeMenu/InventoryTransaction.
model EventRequiredInventory {
  id          String    @id @default(cuid())
  eventId     String
  event       Event     @relation(fields: [eventId], references: [id], onDelete: Cascade)
  inventoryId String
  inventory   Inventory @relation(fields: [inventoryId], references: [id], onDelete: Restrict)
  quantity    Decimal   @db.Decimal(12, 2)

  createdAt DateTime @default(now())

  @@unique([eventId, inventoryId])
  @@index([eventId])
  @@index([inventoryId])
  @@map("event_required_inventory")
}

// Chunk 10 — Sales Pipeline: Order (Quotation, Group 10.1, deferred to a
// later pass per AJ — Order is scoped here to be creatable directly, matching
// the updated doc's order-first flow; a `quotationId` FK gets added on top
// of this same table whenever Quotation lands, same "leave it out until the
// referenced model exists" convention as Chunk 9's `Event.orderId`).

// PRD §21's own state machine, not the updated doc's shorter dashboard-filter
// list — this dev plan's own chunk-10 file already made that call.
enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_PREPARATION
  READY
  COMPLETED
  CANCELLED
}

enum OrderPaymentStatus {
  UNPAID
  PARTIALLY_PAID
  PAID
}

// Updated doc §6's five meal slots.
enum MealType {
  BREAKFAST
  LUNCH
  HITEA
  DINNER
  OTHER
}

// Shared by OrderItem (and, later, QuotationItem) — a catalog line item can
// be a whole priced Menu, a single MenuItem, or an AddOn; exactly one of
// menuId/menuItemId/addOnId is set per row, matching which itemType this is.
enum OrderItemType {
  MENU
  MENU_ITEM
  ADD_ON
}

// Single = one Menu for the whole Order (today's default flow). Multi = one
// Event with different Menus for different meal slots (MealPlanEntry.menuId)
// — day count does not determine this; it's an explicit, overridable choice
// on the Order (src/app/(app)/orders/_components/order-form.tsx).
enum OrderKind {
  SINGLE
  MULTI
}

// Chunk 11 Group 11.2 — the intake form's "Venue Type" dropdown options
// (2026-09-17 reference form).
enum VenueType {
  CLUBHOUSE
  HOTEL
  BANQUET_HALL
  RESORT
  HOME
  OFFICE
  OTHER
}

// Chunk 11 Group 11.2 — the intake form's "Vehicle Access" dropdown options.
enum VehicleAccessType {
  VEHICLE_AND_PARKING
  VEHICLE_NO_PARKING
  NO_VEHICLE_ACCESS
  MANUAL_LOADING_REQUIRED
}

model Order {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Nullable/SetNull, unlike Event's required/Restrict eventTypeId — an
  // Order's own event-type is lightweight categorization, not something
  // Menu Selection logic depends on the way Event's does.
  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  // Chunk 10 Group 10.1 — set only when this Order was converted from an
  // Accepted Quotation (src/modules/quotations/quotation.ts's
  // `convertQuotationToOrder`); null for an Order created directly. Unique:
  // a Quotation converts into at most one Order. SetNull so deleting the
  // Quotation later never deletes the Order it already produced.
  quotationId String?    @unique
  quotation   Quotation? @relation(fields: [quotationId], references: [id], onDelete: SetNull)

  // Single = one Menu for the whole Order; Multi = different Menus per meal
  // slot via MealPlanEntry.menuId. Explicit, not inferred from date range.
  orderKind OrderKind @default(SINGLE)

  // Human-readable, per-tenant sequential label (e.g. "AJ-0001"), assigned
  // once at creation from Organization.orderNumberPrefix/NextValue/Padding —
  // immutable afterward, unlike the pricing fields below. Nullable because
  // Orders created before this feature shipped have none.
  orderNumber String?

  // Updated doc §5 "Event Information" — captured directly on the Order,
  // independent of whether a formal Event row exists yet (Group 10.6).
  eventStartDate DateTime
  eventEndDate   DateTime
  venue          String?
  eventAddress   String?

  // Chunk 11 Group 11.2 (2026-09-17) — the customer-facing event-details
  // intake form's "Menu Preference" and "Event Time" fields, captured here
  // rather than a new model, following this same section's existing
  // precedent of storing intake fields directly on Order. eventMealType
  // reuses MealType (the same enum MealPlanEntry uses) but is independent of
  // it — this is the single meal slot the *whole event* is for, not a
  // per-day Multi Order slot.
  menuPreference FoodType?
  eventMealType  MealType?

  // Chunk 11 Group 11.2 — "Venue & Delivery Details" section of the intake
  // form. `venue`/`eventAddress` above already cover the free-text venue
  // name/full address; these are the additional structured fields the
  // reference form (AJ, 2026-09-17) collects on top of them.
  venueType               VenueType?
  venueDoorNumber         String?
  venueTower              String?
  venueFloor              String?
  venueHallName           String?
  venueLandmark           String?
  venueContactName        String?
  venueContactPhone       String?
  venueLatitude           Float?
  venueLongitude          Float?
  venueAccessInstructions String?
  vehicleAccess           VehicleAccessType?
  liveCounterAvailable    Boolean?

  // Participant Information (Group 10.3) — lets pricing reflect actual
  // guest composition. `totalParticipants` is a UI-suggested default
  // (adultCount+childBelow5Count+child5To10Count) but stored independently/
  // overridable. Children are split by age band (below-5 / 5-10) rather than
  // one flat count, since Menu Type pricing rates now differ by band.
  adultCount        Int?
  childBelow5Count  Int?
  child5To10Count   Int?
  totalParticipants Int?
  adultNonVegCount  Int?
  adultVegCount     Int?

  // Children Guests & Pricing, Single Order only — which Menu's child rates
  // apply to childBelow5Count/child5To10Count above; ignored/stripped
  // server-side for Multi Order, which instead uses each MealPlanEntry's own
  // menuId + its own per-slot counts. SetNull (not Restrict) — deleting a
  // Menu still referenced here shouldn't block or cascade the Order, same
  // precedent as OrderItem.menuId/MealPlanEntry.menuId.
  childPricingMenuId String?
  childPricingMenu   Menu?   @relation(fields: [childPricingMenuId], references: [id], onDelete: SetNull)

  // Meal Planning (Group 10.4) — when true, each MealPlanEntry's own
  // `price` is added into `subtotal`; when false, meal selections are
  // purely operational (which meals, which days) and only `items`
  // (Products & Menu Items) drive pricing.
  individualPricingEnabled Boolean @default(false)

  // Pricing (PRD §21) — `subtotal`/`total`/`balance` are kept in sync by
  // `recalculateOrderTotals` (src/modules/orders/order.ts) whenever items/
  // mealPlanEntries/discount/taxes/advance change, not recomputed ad hoc
  // by every reader. `childrenCharge` is the live-recomputed Children
  // Guests & Pricing contribution folded into `subtotal`.
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  childrenCharge Decimal @default(0) @db.Decimal(12, 2)
  discount       Decimal @default(0) @db.Decimal(12, 2)
  taxes          Decimal @default(0) @db.Decimal(12, 2)
  total          Decimal @default(0) @db.Decimal(12, 2)
  advance        Decimal @default(0) @db.Decimal(12, 2)
  balance        Decimal @default(0) @db.Decimal(12, 2)

  paymentStatus OrderPaymentStatus @default(UNPAID)
  status        OrderStatus        @default(DRAFT)
  notes         String?

  items           OrderItem[]
  mealPlanEntries MealPlanEntry[]
  events          Event[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, orderNumber])
  @@index([organizationId])
  @@index([customerId])
  @@map("order")
}

// No `organizationId` of its own — cascades off its parent Order row.
model OrderItem {
  id       String        @id @default(cuid())
  orderId  String
  order    Order         @relation(fields: [orderId], references: [id], onDelete: Cascade)
  itemType OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  // Set only for a Multi Order's per-meal-slot item picks (chosen from that
  // slot's own Menu); null for every whole-order item, which is all of them
  // on a Single Order. Cascade: a slot's items only make sense scoped to it,
  // so unchecking that meal removes them along with its MealPlanEntry row.
  mealPlanEntryId String?
  mealPlanEntry   MealPlanEntry? @relation(fields: [mealPlanEntryId], references: [id], onDelete: Cascade)

  // Snapshotted at add-time — survives the catalog item being renamed,
  // repriced, or deleted later without silently rewriting a past Order.
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  @@index([orderId])
  @@map("order_item")
}

// No `organizationId` of its own — cascades off its parent Order row.
// Existence of a row = that (date, mealType) is selected for this Order;
// there's no separate boolean to go out of sync with row presence.
model MealPlanEntry {
  id       String   @id @default(cuid())
  orderId  String
  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  date     DateTime
  mealType MealType
  // Only meaningful (and only ever set) when Order.individualPricingEnabled.
  price    Decimal? @db.Decimal(10, 2)

  // Multi Order per-slot Children Guests & Pricing counts — only meaningful
  // (and only ever set) when Order.orderKind === "MULTI", same gating as
  // menuId itself below; priced against this slot's own menuId's rates.
  childBelow5Count Int?
  child5To10Count  Int?

  // Multi Order only (Order.orderKind) — which Menu this specific meal slot
  // uses; null for Single Order and for a Multi Order slot not yet decided.
  menuId String?
  menu   Menu?       @relation(fields: [menuId], references: [id], onDelete: SetNull)
  // Items chosen from that Menu specifically for this slot — see
  // OrderItem.mealPlanEntryId.
  items  OrderItem[]

  createdAt DateTime @default(now())

  @@unique([orderId, date, mealType])
  @@index([orderId])
  @@map("meal_plan_entry")
}

// Chunk 10 Group 10.1 — Quotation (deferred from the initial Chunk 10 pass,
// built once Order already existed, so `Order.quotationId` above is a real
// `@relation` from day one rather than another bare-column-then-migrate).

// PRD §20's exact 7-state list. Customer-facing transitions (VIEWED/
// CHANGES_REQUESTED/ACCEPTED/REJECTED) happen via the public token page,
// not the admin UI.
enum QuotationStatus {
  DRAFT
  SENT
  VIEWED
  CHANGES_REQUESTED
  ACCEPTED
  REJECTED
  EXPIRED
}

model Quotation {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  customerId String
  customer   Customer @relation(fields: [customerId], references: [id], onDelete: Restrict)

  // Nullable, same reasoning as Order.eventTypeId — a Quotation may predate
  // firm event details.
  eventTypeId String?
  eventType   EventType? @relation(fields: [eventTypeId], references: [id], onDelete: SetNull)

  // Nullable, unlike Order's required date range — a Quotation can be sent
  // before dates are finalized; `convertQuotationToOrder` requires both to
  // be set (Order itself requires them) and throws a clear error otherwise.
  eventStartDate DateTime?
  eventEndDate   DateTime?
  venue          String?
  eventAddress   String?

  status          QuotationStatus @default(DRAFT)
  validUntil      DateTime?
  terms           String?
  notes           String?
  // Set by the customer's own Request Changes / Reject action on the
  // public token page — distinct from `notes`, which is the caterer's own.
  customerMessage String?

  // Pricing (PRD §20 — Quotation's own field list is a superset of Order's:
  // additionalCharges/deliveryCharges have no Order equivalent, matching
  // Order's leaner PRD §21 field list; convertQuotationToOrder folds both
  // into the new Order's `taxes` so the converted total still matches).
  subtotal          Decimal @default(0) @db.Decimal(12, 2)
  discount          Decimal @default(0) @db.Decimal(12, 2)
  taxes             Decimal @default(0) @db.Decimal(12, 2)
  additionalCharges Decimal @default(0) @db.Decimal(12, 2)
  deliveryCharges   Decimal @default(0) @db.Decimal(12, 2)
  total             Decimal @default(0) @db.Decimal(12, 2)

  items QuotationItem[]
  order Order?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([customerId])
  @@map("quotation")
}

// No `organizationId` of its own — cascades off its parent Quotation row.
model QuotationItem {
  id          String        @id @default(cuid())
  quotationId String
  quotation   Quotation     @relation(fields: [quotationId], references: [id], onDelete: Cascade)
  itemType    OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  // Snapshotted at add-time, same convention as OrderItem — and the exact
  // values `convertQuotationToOrder` copies onto the new OrderItem rows
  // untouched, so an accepted quotation's price can never silently drift
  // from a later catalog change.
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  @@index([quotationId])
  @@map("quotation_item")
}

// Chunk 11 Groups 11.2/11.3 (2026-09-17) — Menu Selection + Approval
// Workflow. AJ's redesign (see dev plans/chunk-11-menu-selection-approval-
// kitchen.md): no per-event link/token — the customer reaches this through
// Chunk 8's tenant-wide Public Menu Link, identified by phone (Group 11.2),
// with a brand-new Event created per submission. One MenuSelection per
// Event (MenuSelection.eventId is @unique).

// PRD §29's exact 9-state list.
enum MenuSelectionStatus {
  DRAFT
  SENT_TO_CUSTOMER
  CUSTOMER_REVIEWING
  CHANGES_REQUESTED
  CUSTOMER_APPROVED
  KITCHEN_REVIEWING
  KITCHEN_CHANGES_REQUESTED
  KITCHEN_APPROVED
  FINAL_LOCKED
}

// Group 11.5 — PRD §34's Kitchen Display System status, distinct from
// MenuSelectionStatus above (the approval workflow). Only meaningful once
// `status` reaches FINAL_LOCKED; the kitchen team advances it manually,
// one stage at a time, from the Kitchen Dashboard.
enum KitchenProductionStatus {
  PENDING
  PREPARING
  READY
  COMPLETED
}

model MenuSelection {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)

  eventId String @unique
  event   Event  @relation(fields: [eventId], references: [id], onDelete: Cascade)

  status MenuSelectionStatus @default(DRAFT)

  // Group 11.5 — kitchen team's own manual production tracking (§34), only
  // acted on once `status` is FINAL_LOCKED.
  kitchenProductionStatus KitchenProductionStatus @default(PENDING)

  // Bumped each time a post-approval change snapshots the prior state into
  // a new MenuVersion (§30) — the version number `items` below currently
  // represents.
  currentVersion Int @default(1)

  // Set by the customer's/kitchen's own Request Changes action — kept
  // separate per side so neither overwrites the other's comment.
  customerRequestNote String?
  kitchenRequestNote  String?

  submittedAt DateTime?
  lockedAt    DateTime?

  items    MenuSelectionItem[]
  versions MenuVersion[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@map("menu_selection")
}

// No `organizationId` of its own — cascades off its parent MenuSelection
// row, same pattern as OrderItem/QuotationItem. Represents the *current*
// live selection; §30's versioning snapshots this into MenuVersionItem
// before it's changed again once no longer DRAFT.
model MenuSelectionItem {
  id              String        @id @default(cuid())
  menuSelectionId String
  menuSelection   MenuSelection @relation(fields: [menuSelectionId], references: [id], onDelete: Cascade)
  itemType        OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  // Snapshotted at add-time, same convention as OrderItem/QuotationItem.
  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  @@index([menuSelectionId])
  @@map("menu_selection_item")
}

// A frozen snapshot of MenuSelection's items at a point in time — created
// whenever a post-approval change happens (§30: "any post-approval change
// creates a new MenuVersion, never mutates in place"). `status` is
// MenuSelection's status at the moment this version was captured.
model MenuVersion {
  id              String        @id @default(cuid())
  menuSelectionId String
  menuSelection   MenuSelection @relation(fields: [menuSelectionId], references: [id], onDelete: Cascade)

  versionNumber Int
  status        MenuSelectionStatus
  note          String?

  items MenuVersionItem[]

  createdAt DateTime @default(now())

  @@unique([menuSelectionId, versionNumber])
  @@index([menuSelectionId])
  @@map("menu_version")
}

// No `organizationId` of its own — cascades off its parent MenuVersion row.
model MenuVersionItem {
  id            String        @id @default(cuid())
  menuVersionId String
  menuVersion   MenuVersion   @relation(fields: [menuVersionId], references: [id], onDelete: Cascade)
  itemType      OrderItemType

  menuId     String?
  menu       Menu?     @relation(fields: [menuId], references: [id], onDelete: SetNull)
  menuItemId String?
  menuItem   MenuItem? @relation(fields: [menuItemId], references: [id], onDelete: SetNull)
  addOnId    String?
  addOn      AddOn?    @relation(fields: [addOnId], references: [id], onDelete: SetNull)

  name      String
  unitPrice Decimal @db.Decimal(10, 2)
  quantity  Int     @default(1)

  createdAt DateTime @default(now())

  @@index([menuVersionId])
  @@map("menu_version_item")
}
